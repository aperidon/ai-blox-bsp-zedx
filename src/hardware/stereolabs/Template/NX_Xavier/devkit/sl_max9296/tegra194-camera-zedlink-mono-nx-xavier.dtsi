	cam_i2cmux{
		i2c@0 {
						
			/* ZEDX 0 left camera sensor */
			zedx_left0: zedx_left_0@28 {
				
				devnode = "video0";
				
				sync_sensor = "ZED_CAM0";
				sync_sensor_index = <1>;

				AR0234_MODES("0", "serial_a", "0")
				
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						zedx_ar0234_out0: endpoint {
							vc-id = <0>;
							port-index = <0>;
							opt-csi-port = "a";
							bus-width = <NUM_LANES>;
							remote-endpoint = <&zedx_csi_in0>;
						};
					};
				};
			};
			
			/* ZEDX 0 right camera sensor */
			zedx_right0: zedx_right_0@20 {
				
				devnode = "video2";
				
				sync_sensor = "ZED_CAM0";
				sync_sensor_index = <2>;

				AR0234_MODES("1", "serial_a", "0")
				
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						zedx_ar0234_out1: endpoint {
							vc-id = <1>;
							port-index = <0>;
							opt-csi-port = "a";
							bus-width = <NUM_LANES>;
							remote-endpoint = <&zedx_csi_in1>;
						};
					};
				};
			};
			
			zedxone_gs0: zedxone_gs_0@10 {
				
				devnode = "video4";
				
				sync_sensor = "ZEDXONE_CAM0";
				sync_sensor_index = <1>;
				
				AR0234_MODES("0", "serial_a", "0")
											
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						ar0234_ar0234_out0: endpoint {
							vc-id = <0>;
							port-index = <0>;
							opt-csi-port = "a";
							bus-width = <NUM_LANES>;
							remote-endpoint = <&ar0234_csi_in0>;
						};
					};
				};
			};
			
			
			/* ZEDX One UHD 0 camera sensor */
			zedxone_uhd0:zedxone_uhd_0@1a {
				
				devnode = "video6";
				
				sync_sensor = "ZEDXONE_CAM2";
				sync_sensor_index = <1>;

				IMX678_MODES("0", "serial_a", "0")
				
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						imx678_imx678_out0: endpoint {
							vc-id = <0>;
							port-index = <0>;
							opt-csi-port = "a";
							bus-width = <NUM_LANES>;
							remote-endpoint = <&imx678_csi_in0>;
						};
					};
				};
			};
			
			zedx_hdr_left0: zedx_hdr_left_0@3e {
				
				devnode = "video8";
				
				sync_sensor = "ZED_CAM2";
				sync_sensor_index = <1>;
				
				ISX031_MODES("0", "serial_a", "0")

				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						zedxhdr_isx031_out0: endpoint {
							vc-id = <0>;
							port-index = <0>;
							opt-csi-port = "a";
							bus-width = <NUM_LANES>;
							remote-endpoint = <&zedxhdr_csi_in0>;
						};
					};
				};
			};
			
			zedx_hdr_right0: zedx_hdr_right_0@2e {
				
				devnode = "video10";
				
				sync_sensor = "ZED_CAM2";
				sync_sensor_index = <2>;
				
				ISX031_MODES("1", "serial_a", "0")

				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						zedxhdr_isx031_out1: endpoint {
							vc-id = <1>;
							port-index = <0>;
							opt-csi-port = "a";
							bus-width = <NUM_LANES>;
							remote-endpoint = <&zedxhdr_csi_in1>;
						};
					};
				};
			};
			
			zedxone_hdr0: zedxone_hdr_0@4e {
				
				devnode = "video12";
				
				sync_sensor = "ZEDXONE_CAM4";
				sync_sensor_index = <1>;
				
