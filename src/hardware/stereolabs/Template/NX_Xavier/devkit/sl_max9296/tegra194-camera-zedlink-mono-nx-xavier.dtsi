							bus-width = <NUM_LANES>;
							remote-endpoint = <&zedonehdr_csi_in0>;
						};
					};
				};
			};
		};
		
		i2c@1 {
						
			/* ZEDX 1 left camera sensor */
			zedx_left1: zedx_left_1@28 {
				
