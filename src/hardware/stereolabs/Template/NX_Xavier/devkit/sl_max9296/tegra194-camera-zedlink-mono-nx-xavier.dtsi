			/* ZEDX ONE UHD 1 camera sensor */
			zedxone_uhd1:zedxone_uhd_1@1a {
				
				devnode = "video7";
				
				sync_sensor = "ZEDXONE_CAM3";
				sync_sensor_index = <1>;
				
				IMX678_MODES("0", "serial_c", "0")

				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						imx678_imx678_out1: endpoint {
							vc-id = <0>;
							port-index = <2>;
							opt-csi-port = "a";
							bus-width = <NUM_LANES>;
							remote-endpoint = <&imx678_csi_in1>;
						};
					};
				};
			};
			
			zedx_hdr_left1: zedx_hdr_left_1@3e {
				
				devnode = "video9";
				
				sync_sensor = "ZED_CAM3";
				sync_sensor_index = <1>;
				
				ISX031_MODES("0", "serial_c", "0")
											
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						zedxhdr_isx031_out2: endpoint {
							vc-id = <0>;
							port-index = <2>;
							opt-csi-port = "a";
							bus-width = <NUM_LANES>;
							remote-endpoint = <&zedxhdr_csi_in2>;
						};
					};
				};
			};
			
			zedx_hdr_right1: zedx_hdr_right_1@2e {
				
				devnode = "video11";
				
				sync_sensor = "ZED_CAM3";
				sync_sensor_index = <2>;
				
				ISX031_MODES("1", "serial_c", "0")

				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						zedxhdr_isx031_out3: endpoint {
							vc-id = <1>;
							port-index = <2>;
							opt-csi-port = "a";
							bus-width = <NUM_LANES>;
							remote-endpoint = <&zedxhdr_csi_in3>;
						};
					};
				};
			};
			
			zedxone_hdr1: zedxone_hdr_1@4e {
				
				devnode = "video13";
				
				sync_sensor = "ZEDXONE_CAM5";
				sync_sensor_index = <1>;
				
				ISX031_MODES("0", "serial_c", "0")

				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					port@0 {
						reg = <0>;
						zedonehdr_isx031_out1: endpoint {
							vc-id = <0>;
							port-index = <2>;
							opt-csi-port = "a";
							bus-width = <NUM_LANES>;
							remote-endpoint = <&zedonehdr_csi_in1>;
						};
					};
				};
			};
		};
	};
	
	tegra-camera-platform {
		compatible = "nvidia, tegra-camera-platform";
		/**
		* Physical settings to calculate max ISO BW
		*
		* num_csi_lanes = <>;
		* Total number of CSI lanes when all cameras are active
		*
		* max_lane_speed = <>;
		* Max lane speed in Kbit/s
		*
		* min_bits_per_pixel = <>;
		* Min bits per pixel
		*
		* vi_peak_byte_per_pixel = <>;
		* Max byte per pixel for the VI ISO case
		*
		* vi_bw_margin_pct = <>;
		* Vi bandwidth margin in percentage
		*
		* max_pixel_rate = <>;
		* Max pixel rate in Kpixel/s for the ISP ISO case
		*
		* isp_peak_byte_per_pixel = <>;
		* Max byte per pixel for the ISP ISO case
		*
		* isp_bw_margin_pct = <>;
		* Isp bandwidth margin in percentage
		*/
		num_csi_lanes = <4>;
		max_lane_speed = <2000000>;
		min_bits_per_pixel = <8>;
		vi_peak_byte_per_pixel = <2>;
		vi_bw_margin_pct = <25>;
		isp_peak_byte_per_pixel = <5>;
		isp_bw_margin_pct = <25>;
		
		/**
		* The general guideline for naming badge_info contains 3 parts, and is as follows,
		* The first part is the camera_board_id for the module; if the module is in a FFD
		* platform, then use the platform name for this part.
		* The second part contains the position of the module, ex. "rear" or "front".
		* The third part contains the last 6 characters of a part number which is found
		* in the module's specsheet from the vender.
		*/
		modules {
			module00 {
				badge = "zedx_ar0234";
				position = "front";
				orientation = "1";
				status = "okay";
				drivernode0 {
					status = "okay";
					/* Declare PCL support driver (classically known as guid)  */
					pcl_id = "v4l2_sensor";
					/* Driver v4l2 device name */
					devname = "zedx 9-0028";
					/* Declare the device-tree hierarchy to driver instance */
					proc-device-tree = "/proc/device-tree/cam_i2cmux/i2c@0/zedx_left_0@28";
				};
			};
			module01 {
				badge = "zedx_ar0234";
				position = "front";
				orientation = "1";
				status = "okay";
				drivernode0 {
					status = "okay";
					/* Declare PCL support driver (classically known as guid)  */
					pcl_id = "v4l2_sensor";
					/* Driver v4l2 device name */
					devname = "zedx 9-0020";
					/* Declare the device-tree hierarchy to driver instance */
					proc-device-tree = "/proc/device-tree/cam_i2cmux/i2c@0/zedx_right_0@20";
				};
			};
			module02 {
				badge = "zedx_ar0234";
				position = "front";
				orientation = "1";
				status = "okay";
				drivernode0 {
					status = "okay";
					/* Declare PCL support driver (classically known as guid)  */
					pcl_id = "v4l2_sensor";
					/* Driver v4l2 device name */
					devname = "zedx 9-0010";
					/* Declare the device-tree hierarchy to driver instance */
					proc-device-tree = "/proc/device-tree/cam_i2cmux/i2c@0/zedxone_gs_0@10";
				};
			};
			module03 {
				badge = "zedx_imx678";
				position = "front";
				orientation = "1";
				status = "okay";
				drivernode0 {
					status = "okay";
					/* Declare PCL support driver (classically known as guid)  */
					pcl_id = "v4l2_sensor";
					/* Driver v4l2 device name */
					devname = "zedxone_uhd 9-001a";
					/* Declare the device-tree hierarchy to driver instance */
					proc-device-tree = "/proc/device-tree/cam_i2cmux/i2c@0/zedxone_uhd_0@1a";
				};
			};
			module04 {
				badge = "zedx_ar0234";
				position = "front";
				orientation = "1";
				status = "okay";
				drivernode0 {
					status = "okay";
					/* Declare PCL support driver (classically known as guid)  */
					pcl_id = "v4l2_sensor";
					/* Driver v4l2 device name */
					devname = "zedx 10-0028";
					/* Declare the device-tree hierarchy to driver instance */
					proc-device-tree = "/proc/device-tree/cam_i2cmux/i2c@1/zedx_left_1@28";
				};
			};
			module05 {
				badge = "zedx_ar0234";
