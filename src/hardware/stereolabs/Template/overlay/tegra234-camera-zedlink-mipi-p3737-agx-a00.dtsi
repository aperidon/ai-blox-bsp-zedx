#define NUM_LANES 4

#include "Utils/ar0234-sl-modes.dtsi"

/ {
#ifdef BUILDOVERLAY
	fragment-camera-zedx-zedlink-mipi@0 {
		target-path = "/";
		__overlay__ {
#endif
			tegra-capture-vi {
				num-channels = <4>;
				status = "okay";
				ports {
					#address-cells = <1>;
					#size-cells = <0>;
					status = "okay";
					port@0 {
						reg = <0>;
						status = "okay";
						zedone_core_vi_in0: endpoint {
							status = "okay";
							vc-id = <0>;
							port-index = <0>;
							bus-width = <4>;
							remote-endpoint = <&zedone_core_csi_out0>;
						};
					};
					port@1 {
						reg = <1>;
						status = "okay";
						zedone_core_vi_in1: endpoint {
							status = "okay";
							vc-id = <0>;
							port-index = <2>;
							bus-width = <4>;
							remote-endpoint = <&zedone_core_csi_out1>;
						};
					};
					port@2 {
						reg = <2>;
						status = "okay";
						zedone_core_vi_in2: endpoint {
							status = "okay";
							vc-id = <0>;
							port-index = <4>;
							bus-width = <4>;
							remote-endpoint = <&zedone_core_csi_out2>;
						};
					};
					port@3 {
						reg = <3>;
						status = "okay";
						zedone_core_vi_in3: endpoint {
							status = "okay";
							vc-id = <0>;
							port-index = <5>;
							bus-width = <4>;
							remote-endpoint = <&zedone_core_csi_out3>;
						};
					};
				};
			};
			bus@0 {
				host1x@13e00000 {
					nvcsi@15a00000 {
						num-channels = <4>;
						#address-cells = <1>;
						#size-cells = <0>;
						status = "okay";
						channel@0 {
							reg = <0>;
							status = "okay";
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								status = "okay";
								port@0 {
									reg = <0>;
									status = "okay";
									zedone_core_csi_in0: endpoint@0 {
										status = "okay";
										port-index = <0>;
										bus-width = <4>;
										remote-endpoint = <&zedone_core_out0>;
									};
								};
								port@1 {
									reg = <1>;
									status = "okay";
									zedone_core_csi_out0: endpoint@1 {
										status = "okay";
										remote-endpoint = <&zedone_core_vi_in0>;
									};
								};
							};
						};
						channel@1 {
							reg = <1>;
							status = "okay";
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								status = "okay";
								port@0 {
									reg = <0>;
									status = "okay";
									zedone_core_csi_in1: endpoint@2 {
										status = "okay";
										port-index = <2>;
										bus-width = <4>;
										remote-endpoint = <&zedone_core_out1>;
									};
								};
								port@1 {
									reg = <1>;
									status = "okay";
									zedone_core_csi_out1: endpoint@3 {
										status = "okay";
										remote-endpoint = <&zedone_core_vi_in1>;
									};
								};
							};
						};
						channel@2 {
							reg = <2>;
							status = "okay";
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								status = "okay";
								port@0 {
									reg = <0>;
									status = "okay";
									zedone_core_csi_in2: endpoint@4 {
										status = "okay";
										port-index = <4>;
										bus-width = <4>;
										remote-endpoint = <&zedone_core_out2>;
									};
								};
								port@1 {
									reg = <1>;
									status = "okay";
									zedone_core_csi_out2: endpoint@5 {
										status = "okay";
										remote-endpoint = <&zedone_core_vi_in2>;
									};
								};
							};
						};
						channel@3 {
							reg = <3>;
							status = "okay";
							ports {
								#address-cells = <1>;
								#size-cells = <0>;
								status = "okay";
								port@0 {
									reg = <0>;
									status = "okay";
									zedone_core_csi_in3: endpoint@6 {
										status = "okay";
										port-index = <6>;
										bus-width = <4>;
										remote-endpoint = <&zedone_core_out3>;
									};
								};
								port@1 {
									reg = <1>;
									status = "okay";
									zedone_core_csi_out3: endpoint@7 {
										status = "okay";
										remote-endpoint = <&zedone_core_vi_in3>;
									};
								};
							};
						};
					};
				};

				i2c@3180000 {
					tca9546@70 {
							i2c@0 {
								zedone_core0: zedone_core_0@10 {

									devnode = "video0";

									sync_sensor = "ZEDXONE_CAM0";
									sync_sensor_index = <1>;

									AR0234_MODES("0", "serial_a", "0")

									ports {
										#address-cells = <1>;
										#size-cells = <0>;
										port@0 {
											reg = <0>;
											zedone_core_out0: endpoint {
												vc-id = <0>;
												port-index = <0>;
												opt-csi-port = "d";
												bus-width = <4>;
												i2c-cc = <0>;
												remote-endpoint = <&zedone_core_csi_in0>;
											};
										};
									};
								};
							};
							i2c@1 {
								zedone_core1: zedone_core_1@10 {

									devnode = "video1";

									sync_sensor = "ZEDXONE_CAM1";
									sync_sensor_index = <1>;

									AR0234_MODES("0", "serial_c", "0")

									ports {
										#address-cells = <1>;
										#size-cells = <0>;
										port@0 {
											reg = <0>;
											zedone_core_out1: endpoint {
												vc-id = <0>;
												port-index = <2>;
												opt-csi-port = "d";
												bus-width = <4>;
												i2c-cc = <0>;
												remote-endpoint = <&zedone_core_csi_in1>;
											};
										};
									};
								};
							};
							i2c@2 {
								zedone_core2: zedone_core_2@10 {

									devnode = "video2";

									sync_sensor = "ZEDXONE_CAM2";
									sync_sensor_index = <1>;

									AR0234_MODES("0", "serial_e", "0")

									ports {
										#address-cells = <1>;
										#size-cells = <0>;
										port@0 {
											reg = <0>;
											zedone_core_out2: endpoint {
												vc-id = <0>;
												port-index = <4>;
												opt-csi-port = "d";
												bus-width = <4>;
												i2c-cc = <0>;
												remote-endpoint = <&zedone_core_csi_in2>;
											};
										};
									};
								};
							};
							i2c@3 {
								zedone_core3: zedone_core_3@10 {

									devnode = "video3";

									sync_sensor = "ZEDXONE_CAM3";
									sync_sensor_index = <1>;

									AR0234_MODES("0", "serial_g", "0")

									ports {
										#address-cells = <1>;
										#size-cells = <0>;
										port@0 {
											reg = <0>;
											zedone_core_out3: endpoint {
												vc-id = <0>;
												port-index = <6>;
												opt-csi-port = "d";
												bus-width = <4>;
												i2c-cc = <0>;
												remote-endpoint = <&zedone_core_csi_in3>;
											};
										};
									};
								};
							};
					};
				};
			};
			tegra-camera-platform {
				compatible = "nvidia, tegra-camera-platform";
				/**
				* Physical settings to calculate max ISO BW
				*
				* num_csi_lanes = <>;
				* Total number of CSI lanes when all cameras are active
				*
				* max_lane_speed = <>;
				* Max lane speed in Kbit/s
				*
				* min_bits_per_pixel = <>;
				* Min bits per pixel
				*
				* vi_peak_byte_per_pixel = <>;
				* Max byte per pixel for the VI ISO case
				*
				* vi_bw_margin_pct = <>;
				* Vi bandwidth margin in percentage
				*
				* max_pixel_rate = <>;
				* Max pixel rate in Kpixel/s for the ISP ISO case
				*
				* isp_peak_byte_per_pixel = <>;
				* Max byte per pixel for the ISP ISO case
				*
				* isp_bw_margin_pct = <>;
				* Isp bandwidth margin in percentage
				*/
				num_csi_lanes = <16>;
				max_lane_speed = <2000000>;
				min_bits_per_pixel = <8>;
				vi_peak_byte_per_pixel = <2>;
				vi_bw_margin_pct = <25>;
				isp_peak_byte_per_pixel = <5>;
				isp_bw_margin_pct = <25>;
				
				/**
				* The general guideline for naming badge_info contains 3 parts, and is as follows,
				* The first part is the camera_board_id for the module; if the module is in a FFD
				* platform, then use the platform name for this part.
				* The second part contains the position of the module, ex. "rear" or "front".
				* The third part contains the last 6 characters of a part number which is found
				* in the module's specsheet from the vender.
				*/
				modules {
					module0 {
						badge = "zedx_ar0234";
						position = "front";
						orientation = "1";
						status = "okay";
						drivernode1 { status = "disabled"; };
						drivernode0 {
							status = "okay";
							/* Declare PCL support driver (classically known as guid)  */
							pcl_id = "v4l2_sensor";
							devname = "zedx 9-0010";
							/* Declare the device-tree hierarchy to driver instance */
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/i2c@3180000/tca9546@70/i2c@0/zedone_core_0@10";
						};
					};
					module1 {
						badge = "zedx_ar0234";
						position = "rear";
						orientation = "1";
						status = "okay";
						drivernode1 { status = "disabled"; };
						drivernode0 {
							status = "okay";
							/* Declare PCL support driver (classically known as guid)  */
							pcl_id = "v4l2_sensor";
							devname = "zedx 10-0010";
							/* Declare the device-tree hierarchy to driver instance */
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/i2c@3180000/tca9546@70/i2c@1/zedone_core_1@10";
						};
					};
					module2 {
						badge = "zedx_ar0234";
						position = "centerleft";
						orientation = "1";
						status = "okay";
						drivernode1 { status = "disabled"; };
						drivernode0 {
							status = "okay";
							/* Declare PCL support driver (classically known as guid)  */
							pcl_id = "v4l2_sensor";
							devname = "zedx 11-0010";
							/* Declare the device-tree hierarchy to driver instance */
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/i2c@3180000/tca9546@70/i2c@2/zedone_core_2@10";
						};
					};
					module3 {
						badge = "zedx_ar0234";
						position = "centerright";
						orientation = "1";
						status = "okay";
						drivernode1 { status = "disabled"; };
						drivernode0 {
							status = "okay";
							/* Declare PCL support driver (classically known as guid)  */
							pcl_id = "v4l2_sensor";
							devname = "zedx 12-0010";
							/* Declare the device-tree hierarchy to driver instance */
							sysfs-device-tree = "/sys/firmware/devicetree/base/bus@0/i2c@3180000/tca9546@70/i2c@3/zedone_core_3@10";
						};
					};
					module4 {
						status = "okay";
					};
					module5 {
						status = "okay";
					};
					module6 {
						status = "okay";
					};
					module7 {
						status = "okay";
					};
				};
			};
#ifdef BUILDOVERLAY
		};
	};
#endif
};
