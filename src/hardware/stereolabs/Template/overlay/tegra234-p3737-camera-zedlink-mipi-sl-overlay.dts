#ifdef BUILDOVERLAY
/dts-v1/;
/plugin/;
#endif 

#include "tegra234-camera-zedlink-mipi-p3737-agx-a00.dtsi"
#include "Utils/camera-clks.dtsi"
#include "dt-bindings/gpio/tegra234-gpio.h"
#include "dt-bindings/clock/tegra234-clock.h"
#include <dt-bindings/tegra234-p3737-0000+p3701-0000.h>

#define CAM0_RST_L      TEGRA234_MAIN_GPIO(H, 3)
#define CAM0_PWDN       TEGRA234_MAIN_GPIO(H, 6)
#define CAM1_RST_L      TEGRA234_MAIN_GPIO(AC, 2)
#define CAM1_PWDN       TEGRA234_MAIN_GPIO(AC, 0)
#define PWR_EN      TEGRA234_MAIN_GPIO(AC, 7)
#define GYRO1_IRQ_GPIO  TEGRA234_AON_GPIO(CC, 1)
#define ACCE1_IRQ_GPIO  TEGRA234_AON_GPIO(CC, 0)

/* camera control gpio definitions */
/ {
#ifdef BUILDOVERLAY
	overlay-name = "Jetson Mipi Camera Overlay";
	jetson-header-name = "Jetson AGX CSI Connector";
	compatible = JETSON_COMPATIBLE;

	fragment-camera-zedx-zedlink-mipi@0 {
		target-path = "/";
		__overlay__ {
#endif
			bus@0 {
				i2c@3180000 {
					clock-frequency = <0x61a80>; // Set to 400 kHz
					tca9546@70 {
						compatible = "nxp,pca9546";
						reg = <0x70>;
						#address-cells = <1>;
						#size-cells = <0>;
						i2c-mux-idle-disconnect;
						idle-state = <1>;
						skip_mux_detect = "yes";
						vcc_lp = "vcc";
						status = "okay";
						
						i2c@0 {
							reg = <0>;
							i2c-mux,deselect-on-exit;
							#address-cells = <1>;
							#size-cells = <0>;

							/delete-node/ dual_hawk_a@18;
							/delete-node/ single_max96712_a@62;

							zedone_core0: zedone_core_0@10 {
								status = "okay";
								compatible = "stereolabs,zedx";
								reg = <0x10>;

								ZED_ORIN_CLKS

								zedx-id = "0";
								channel = "a";   /* deserializer channel */
								is-mipi;
								has-eeprom;
								eeprom-addr=<0x56>;
								has-trigger-ctrl;
								trigger-ctrl-addr = <0x3C>;
								trigger-ctrl-reg  = <0x02>;
							};
							
							/* IMU A*/
							bmi088_a: bmi088_a_@69 {
								status = "okay";
								compatible = "bmi,bmi088";
								reg = <0x69>; /* <-- Must be gyroscope I2C address */
								accel_i2c_addr = <0x19>; /* Must be specified */
								accel_matrix    = [01 00 00 00 01 00 00 00 01];
								gyro_matrix        = [01 00 00 00 01 00 00 00 01];
							};
						};
						i2c@1 {
							status = "okay";
							reg = <1>;
							i2c-mux,deselect-on-exit;
							#address-cells = <1>;
							#size-cells = <0>;

							zedone_core1: zedone_core_1@10 {
								status = "okay";
								compatible = "stereolabs,zedx";
								reg = <0x10>;

								ZED_ORIN_CLKS

								zedx-id = "1";
								channel = "a";   /* deserializer channel */
								is-mipi;
								has-eeprom;
								eeprom-addr=<0x56>;
								has-trigger-ctrl;
								trigger-ctrl-addr = <0x3C>;
								trigger-ctrl-reg  = <0x02>;
							};

							/* IMU B */
							bmi088_b: bmi088_b_@69 {
								status = "okay";
								compatible = "bmi,bmi088";
								reg = <0x69>; /* <-- Must be gyroscope I2C address */
								accel_i2c_addr = <0x19>; /* Must be specified */
								accel_matrix    = [01 00 00 00 01 00 00 00 01];
								gyro_matrix        = [01 00 00 00 01 00 00 00 01];
							};
						};
						i2c@2 {
							status = "okay";
							reg = <2>;
							i2c-mux,deselect-on-exit;
							#address-cells = <1>;
							#size-cells = <0>;

							zedone_core2: zedone_core_2@10 {
								status = "okay";
								compatible = "stereolabs,zedx";
								reg = <0x10>;

								ZED_ORIN_CLKS

								zedx-id = "2";
								channel = "a";   /* deserializer channel */
								is-mipi;
								has-eeprom;
								eeprom-addr=<0x56>;
								has-trigger-ctrl;
								trigger-ctrl-addr = <0x3C>;
								trigger-ctrl-reg  = <0x02>;
							};

							/* IMU C */
							bmi088_c: bmi088_c_@69 {
								status = "okay";
								compatible = "bmi,bmi088";
								reg = <0x69>; /* <-- Must be gyroscope I2C address */
								accel_i2c_addr = <0x19>; /* Must be specified */
								accel_matrix    = [01 00 00 00 01 00 00 00 01];
								gyro_matrix        = [01 00 00 00 01 00 00 00 01];
							};
						};
						i2c@3 {
							status = "okay";
							reg = <3>;
							i2c-mux,deselect-on-exit;
							#address-cells = <1>;
							#size-cells = <0>;

							zedone_core3: zedone_core_3@10 {
								status = "okay";
								compatible = "stereolabs,zedx";
								reg = <0x10>;

								ZED_ORIN_CLKS

								zedx-id = "3";
								channel = "a";   /* deserializer channel */
								is-mipi;
								has-eeprom;
								eeprom-addr=<0x56>;
								has-trigger-ctrl;
								trigger-ctrl-addr = <0x3C>;
								trigger-ctrl-reg  = <0x02>;
							};

							/* IMU D */
							bmi088_d: bmi088_d_@69 {
								status = "okay";
								compatible = "bmi,bmi088";
								reg = <0x69>; /* <-- Must be gyroscope I2C address */
								accel_i2c_addr = <0x19>; /* Must be specified */
								accel_matrix    = [01 00 00 00 01 00 00 00 01];
								gyro_matrix        = [01 00 00 00 01 00 00 00 01];
							};
						};
					};
				};
			};
#ifdef BUILDOVERLAY
		};
	};
	fragment-cam-cdi-tsc@0 {
		target-path = "/";
		__overlay__ {
#endif
			tsc_sig_gen@c6a0000 {
				status = "okay";
				generator@380 {
					status = "okay";
				};
			};
#ifdef BUILDOVERLAY
		};
	};
	fragment-cam-reset-hogs@0 {
		target-path = "/";
		__overlay__ {
#endif
			bus@0 {
				gpio@2200000 {
					/*
					 * Assert the four per-sensor camera reset lines high at
					 * boot 
					 */
					cam0_rst_hog {
						gpio-hog;
						gpios = <CAM0_RST_L GPIO_ACTIVE_HIGH>;
						output-high;
						line-name = "cam0-reset";
					};
					cam1_rst_hog {
						gpio-hog;
						gpios = <CAM0_PWDN GPIO_ACTIVE_HIGH>;
						output-high;
						line-name = "cam1-reset";
					};
					cam2_rst_hog {
						gpio-hog;
						gpios = <CAM1_RST_L GPIO_ACTIVE_HIGH>;
						output-high;
						line-name = "cam2-reset";
					};
					cam3_rst_hog {
						gpio-hog;
						gpios = <CAM1_PWDN GPIO_ACTIVE_HIGH>;
						output-high;
						line-name = "cam3-reset";
					};
				};
			};
#ifdef BUILDOVERLAY
		};
	};
#endif
};
