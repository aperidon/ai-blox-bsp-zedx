#ifdef BUILDOVERLAY
/dts-v1/;
/plugin/;
#endif 

#include "tegra234-camera-zedlink-mono-zedbox.dtsi"
#include "Utils/camera-clks.dtsi"
#include "dt-bindings/gpio/tegra234-gpio.h"
#include "dt-bindings/clock/tegra234-clock.h"
#include <dt-bindings/tegra234-p3767-0000-common.h>

#define CAM0_RST_L  TEGRA234_MAIN_GPIO(H, 3)
#define CAM0_PWDN   TEGRA234_MAIN_GPIO(H, 6)
#define CAM1_RST_L  TEGRA234_MAIN_GPIO(AC, 1)
#define CAM1_PWDN   TEGRA234_MAIN_GPIO(AC, 0)
#define PWR_EN      TEGRA234_MAIN_GPIO(AC, 7)
#define CAM_I2C_MUX	TEGRA234_AON_GPIO(CC, 3)

#define CAMERA_I2C_MUX_BUS(x) (0x1E + x)


/* camera control gpio definitions */
/ {
#ifdef BUILDOVERLAY
	overlay-name = "Jetson Camera Zedbox Orin Mono";
	jetson-header-name = "Jetson 24pin CSI Connector";
	compatible = JETSON_COMPATIBLE_P3768;

	fragment-camera-imx219@0 {
		target-path = "/";
		__overlay__ {
#endif
			bus@0 {
				cam_i2cmux{
					i2c@0 {
						/delete-node/ rbpcv2_imx219_a@10;
					};
					i2c@1 {
						/delete-node/ rbpcv2_imx219_c@10;
					};
				};
				gpio@2200000 {
					camera-control-output-low
					{
						status="disabled";
					};
				};
			};
#ifdef BUILDOVERLAY
		};
	};
	
	fragment-camera-zedx-zedlink-mono@0 {
		target-path = "/";
		__overlay__ {
#endif
			bus@0 {
				cam_i2cmux{
					status = "okay";
					compatible = "i2c-mux-gpio";
					#address-cells = <1>;
					#size-cells = <0>;
					i2c-parent = <&cam_i2c>;
					mux-gpios = <&gpio_aon CAM_I2C_MUX GPIO_ACTIVE_HIGH>;

					i2c@0 {
						reg = <0>;
						#address-cells = <1>;
						#size-cells = <0>;
						status = "okay";
						
					};
					
					/* /dev/i2c-10/ */
					i2c@1 {
						reg = <1>;
						#address-cells = <1>;
						#size-cells = <0>;
						status = "okay";

						/* deserializer MAX9296 at address 0x48*/
						max9296_a@48 {
							compatible = "stereolabs,sl_max9296";
							reg = <0x48>;  /* deserializer i2c_address */
							channel = "a"; /* deserializer channel: one per deser */
							sync_mode = "master";
							camera-serializers = < &zedxone_hdr_ser0 &zedx_hdr_ser0 &zedxone_gs_ser0 &zedxone_uhd_ser0 &zedx_ser0>;
							pwdn-gpio = <&gpio CAM1_PWDN GPIO_ACTIVE_HIGH>;
						};

						/* ZEDX Left Cam */
						zedx_left0: zedx_left_0@28 {
							compatible = "stereolabs,zedx";
							reg = <0x28>;

							ZED_ORIN_CLKS

							zedx-id = "0";
							channel = "a";   /* deserializer channel */
							
							has-eeprom;
							eeprom-addr = <0x54>;
						};
						
						/* ZEDX Right Cam */
						zedx_right0: zedx_right_0@20 {
							compatible = "stereolabs,zedx";
							reg = <0x20>;

							ZED_ORIN_CLKS

							zedx-id = "0";
							channel = "a";  /* deserializer channel */
							
							has-eeprom;
							eeprom-addr=<0x54>;
						};

						/* ZEDX One GS 0 Cam */
						zedxone_gs0: zedxone_gs_0@10 {
							compatible = "stereolabs,zedx";
							reg = <0x10>;

							ZED_ORIN_CLKS

							zedx-id = "1";
							channel = "a";   /* deserializer channel */
							
							has-eeprom;
							eeprom-addr=<0x56>;
						};
					
						/*ZEDX One 4K 0 Cam*/
						zedxone_uhd0:zedxone_uhd_0@1a {
							compatible = "stereolabs,zedxone_uhd";
							reg = <0x1a>;

							ZED_ORIN_CLKS

							zedx-id = "2";
							channel = "a";

							has-eeprom;
							eeprom-addr=<0x54>;
						};

						/* ZEDX Pro Right Cam 0 */
						zedx_hdr_right0: zedx_hdr_right_0@2e {
							compatible = "stereolabs,zedxhdr";
							reg = <0x2e>;

							ZED_ORIN_CLKS

							channel = "a"; /* deserializer channel */
							zedx-id = "3";
							
							has-eeprom;
							eeprom-addr = <0x52>;
						};
						
						/* ZEDX Pro Left Cam 0 */
						zedx_hdr_left0: zedx_hdr_left_0@3e {
							compatible = "stereolabs,zedxhdr";
							reg = <0x3e>;

							ZED_ORIN_CLKS

							channel = "a";  /* deserializer channel */
							zedx-id = "3";
							
							has-eeprom;
							eeprom-addr = <0x52>;
						};

						/* ZEDX One pro Cam 0 */
						zedxone_hdr0: zedxone_hdr_0@4e {
							compatible = "stereolabs,zedxhdr";
							reg = <0x4e>;

							ZED_ORIN_CLKS

							zedx-id = "4";
							channel = "a";  /* deserializer channel */
							
							has-eeprom;
							eeprom-addr = <0x52>;
						};

						zedxone_hdr_ser0: zedxone_hdr_ser_0@40 {
							compatible = "stereolabs,sl_max9295";
							reg = <0x40>;

							zedx-id = "4";
							channel = "a";
							mode = "master";

							camera_model = "zedonehdr";
							camera-sensors = <&zedxone_hdr0>;
							imu = <&bmi088_b>;
						};
					
						zedx_hdr_ser0: zedx_hdr_ser_0@60 {
							compatible = "stereolabs,sl_max9295";
							reg = <0x60>;

							zedx-id = "3";
							channel = "a";
							mode = "master";
							
							camera_model = "zedxhdr";
							camera-sensors = <&zedx_hdr_right0 &zedx_hdr_left0>;//!\\ Different order than ZED-X
							imu = <&bmi088_b>;
						};

						zedxone_gs_ser0: zedxone_gs_ser_0@42 {
							compatible = "stereolabs,sl_max9295";
							reg = <0x42>;

							zedx-id = "1";
							channel = "a";
							mode = "master";
							
							camera_model = "zedonegs";
							camera-sensors = <&zedxone_gs0>;
							imu = <&bmi088_b>;
						};
					
						zedxone_uhd_ser0: zedxone_uhd_ser_0@44 {
							compatible = "stereolabs,sl_max9295";
							reg = <0x44>;

							zedx-id = "2";
							channel = "a";
							mode = "master";

							camera_model = "zedone4k";
							camera-sensors = <&zedxone_uhd0>;
							imu = <&bmi088_b>;
						};

						/* ZEDX 0 Serializer */
						zedx_ser0: zedx_ser_0@62 {
							compatible = "stereolabs,sl_max9295";
							reg = <0x62>;

							zedx-id = "0";
							channel = "a";
							mode = "master";
							
							camera_model = "zedx";
							camera-sensors = <&zedx_left0 &zedx_right0>;
							imu = <&bmi088_b>;
						};

						/* IMU B*/
						bmi088_b: bmi088_b_@4b {
							status = "okay";
							compatible = "bmi,bmi088";
							reg = <0x4b>; /* <-- Must be gyroscope I2C address */
							accel_i2c_addr = <0x4c>; /* Must be specified */
							accel_matrix    = [01 00 00 00 01 00 00 00 01];
							gyro_matrix        = [01 00 00 00 01 00 00 00 01];
						};
					};
				};
			};
			#ifdef BUILDOVERLAY
		};
	};
	#endif
};
