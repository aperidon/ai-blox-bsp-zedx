							zedxone_hdr_ser6: zedxone_hdr_ser_6@40 {
								compatible = "stereolabs,sl_max9295";
								reg = <0x40>;

								zedx-id = "34";
								channel = "b";
								mode = "master";

								camera_model = "zedonehdr";
								camera-sensors = <&zedxone_hdr6>;
								imu = <&bmi088_g &bmi088_h>;
							};

							zedxone_hdr_ser7: zedxone_hdr_ser_7@41 {
								compatible = "stereolabs,sl_max9295";
								reg = <0x41>;

								zedx-id = "35";
								channel = "b";
								mode = "master";

								camera_model = "zedonehdr";
								camera-sensors = <&zedxone_hdr7>;
								imu = <&bmi088_g &bmi088_h>;
							};

							/* IMU G*/
							bmi088_g: bmi088_g_@3b {
								status = "okay";
								compatible = "bmi,bmi088";
								reg = <0x3b>; /* <-- Must be gyroscope I2C address */
								accel_i2c_addr = <0x3c>; /* Must be specified */
								accel_matrix    = [01 00 00 00 01 00 00 00 01];
								gyro_matrix        = [01 00 00 00 01 00 00 00 01];
							};

							/* IMU H*/
							bmi088_h: bmi088_h_@4b {
								status = "okay";
								compatible = "bmi,bmi088";
								reg = <0x4b>; /* <-- Must be gyroscope I2C address */
								accel_i2c_addr = <0x4c>; /* Must be specified */
								accel_matrix    = [01 00 00 00 01 00 00 00 01];
								gyro_matrix        = [01 00 00 00 01 00 00 00 01];
							};
						};
					};
				};
			};
#ifdef BUILDOVERLAY
		};	
	};
	fragment-cam-cdi-tsc@0 {
		target-path = "/";
		__overlay__ {
#endif
			tsc_sig_gen@c6a0000 {
				status = "okay";
				generator@380 {
					status = "okay";
				};
			};
#ifdef BUILDOVERLAY
		};
	};
#endif
};
