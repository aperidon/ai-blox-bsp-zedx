				i2c@3180000 {
					clock-frequency = <400000>; // Set to 400 kHz
					tca9546@70 {
						compatible = "nxp,pca9546";
						reg = <0x70>;
						#address-cells = <1>;
						#size-cells = <0>;
						i2c-mux-idle-disconnect;
						idle-state = <1>;
						skip_mux_detect = "yes";
						vcc_lp = "vcc";
						status = "okay";

						/* /dev/i2c-31/ */
						i2c@0 {
							reg = <0>;
							i2c-mux,deselect-on-exit;
							#address-cells = <1>;
							#size-cells = <0>;

							max96712_b@29 {
								compatible = "stereolabs,sl_max96712";
								reg = <0x29>;  /* deserializer i2c_address */
								channel = "b"; /* deserializer channel: one per deser */
								pwr-gpio = <&gpio CAM1_PWDN GPIO_ACTIVE_HIGH>;

								camera-serializers = < 	
									/* GMSL 4 */ &zedx_ser4 &zedxone_gs_ser4 &zedxone_uhd_ser4 			&zedx_hdr_ser4 &zedxone_hdr_ser4
									/* GMSL 5 */ &zedx_ser5 &zedxone_gs_ser5 &dummy_zedxone_uhd_ser_b  	&zedx_hdr_ser5 &zedxone_hdr_ser5
									/* GMSL 6 */ &zedx_ser6 &zedxone_gs_ser6 &zedxone_uhd_ser6 			&zedx_hdr_ser6 &zedxone_hdr_ser6
									/* GMSL 7 */ &zedx_ser7 &zedxone_gs_ser7 &dummy_zedxone_uhd_ser_b  	&zedx_hdr_ser7 &zedxone_hdr_ser7 >;					
							};

							/* DUMMY  -  Do not populate */
							zedxone_uhd_b:zedxone_uhd@1a {};
							dummy_zedxone_uhd_ser_b: zedxone_uhd_ser@44 {
