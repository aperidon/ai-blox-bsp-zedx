config SL_VIDEO_ZEDONE4K
	tristate "ZED-4K IMX678 prototype camera sensor support"
	depends on I2C && VIDEO_V4L2 && VIDEO_V4L2_SUBDEV_API && ( SL_DESER_MAX96712 || SL_DESER_MAX96724 || SL_DESER_MAX9296 )
	help
	  This is a Video4Linux2 sensor-level driver for Stereolabs ZED-One 4K
	  prototype camera.

	  To compile this driver as a module, choose M here: the module
	  will be called imx678.ko and will be compile with max929x.ko.
