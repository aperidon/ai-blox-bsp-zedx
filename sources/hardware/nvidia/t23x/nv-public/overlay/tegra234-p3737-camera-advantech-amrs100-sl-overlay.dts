						mclk = "extperiph1";
						zedx-id = "18";
						channel = "b";  /* deserializer channel */
						mode = "slave"; /* the serializer of the ZEDX 0 is already */
						/* initialized */
						has-eeprom;
						eeprom-addr=<0x54>;
					};

