						imu = < &bmi088_e &bmi088_f &bmi088_g &bmi088_h >;

					};
					
					/* IMU E*/
					bmi088_e: bmi088_e_@3b {
						//compatible = "bmi,bmi088";
						reg = <0x3b>; /* <-- Must be gyroscope I2C address */
						accel_i2c_addr = <0x3c>; /* Must be specified */
						accel_matrix    = [01 00 00 00 01 00 00 00 01];
						gyro_matrix        = [01 00 00 00 01 00 00 00 01];
					};

					/* IMU F*/
					bmi088_f: bmi088_f_@4b {
						//compatible = "bmi,bmi088";
						reg = <0x4b>; /* <-- Must be gyroscope I2C address */
						accel_i2c_addr = <0x4c>; /* Must be specified */
						accel_matrix    = [01 00 00 00 01 00 00 00 01];
						gyro_matrix        = [01 00 00 00 01 00 00 00 01];
					};

					/* IMU G*/
					bmi088_g: bmi088_g_@5b {
						//compatible = "bmi,bmi088";
						reg = <0x5b>; /* <-- Must be gyroscope I2C address */
						accel_i2c_addr = <0x5c>; /* Must be specified */
						accel_matrix    = [01 00 00 00 01 00 00 00 01];
						gyro_matrix        = [01 00 00 00 01 00 00 00 01];
					};

					/* IMU H*/
					bmi088_h: bmi088_h_@6b {
						//compatible = "bmi,bmi088";
						reg = <0x6b>; /* <-- Must be gyroscope I2C address */
						accel_i2c_addr = <0x6c>; /* Must be specified */
						accel_matrix    = [01 00 00 00 01 00 00 00 01];
						gyro_matrix        = [01 00 00 00 01 00 00 00 01];
					};
				};
			};
		};	
