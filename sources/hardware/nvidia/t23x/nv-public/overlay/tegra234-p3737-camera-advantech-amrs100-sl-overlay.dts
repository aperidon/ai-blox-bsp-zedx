					};
					
					/* IMU A*/
					bmi088_a: bmi088_a_@3b {
						//compatible = "bmi,bmi088";
						reg = <0x3b>; /* <-- Must be gyroscope I2C address */
						accel_i2c_addr = <0x3c>; /* Must be specified */
						accel_matrix    = [01 00 00 00 01 00 00 00 01];
						gyro_matrix        = [01 00 00 00 01 00 00 00 01];
					};

					/* IMU B*/
					bmi088_b: bmi088_b_@4b {
						//compatible = "bmi,bmi088";
						reg = <0x4b>; /* <-- Must be gyroscope I2C address */
						accel_i2c_addr = <0x4c>; /* Must be specified */
						accel_matrix    = [01 00 00 00 01 00 00 00 01];
						gyro_matrix        = [01 00 00 00 01 00 00 00 01];
					};

					/* IMU C*/
					bmi088_c: bmi088_c_@5b {
						//compatible = "bmi,bmi088";
						reg = <0x5b>; /* <-- Must be gyroscope I2C address */
						accel_i2c_addr = <0x5c>; /* Must be specified */
						accel_matrix    = [01 00 00 00 01 00 00 00 01];
						gyro_matrix        = [01 00 00 00 01 00 00 00 01];
					};

					/* IMU D*/
					bmi088_d: bmi088_d_@6b {
						//compatible = "bmi,bmi088";
						reg = <0x6b>; /* <-- Must be gyroscope I2C address */
						accel_i2c_addr = <0x6c>; /* Must be specified */
						accel_matrix    = [01 00 00 00 01 00 00 00 01];
						gyro_matrix        = [01 00 00 00 01 00 00 00 01];
					};
				};


				i2c@3180000 {
					/* deserializer MAX96712 at address 0x29 */
					max96712_b@29 {
						compatible = "stereolabs,sl_max96712";
						reg = <0x29>;  /* deserializer i2c_address */
						channel = "b"; /* deserializer channel: one per deser */
						pwr-gpio = <&gpio CAM1_PWDN GPIO_ACTIVE_HIGH>;

						n_lanes = "2";

						/* WARNING : Deserializer order will determine detetion order */
						/* to ensure right i2c follow this order: i2c@0 / i2c@1 / i2c@0 / i2c@1 */
						camera-serializers = < 	&zedx_ser4 &zedx_ser5 &zedx_ser6 &zedx_ser7 
												&zedxone_gs_ser4 &zedxone_gs_ser5 &zedxone_gs_ser6 &zedxone_gs_ser7 
												&zedxone_uhd_ser1
												&zedx_pro_ser4 &zedx_pro_ser5 &zedx_pro_ser6 &zedx_pro_ser7
												&zedxone_pro_ser4 &zedxone_pro_ser5 &zedxone_pro_ser6 &zedxone_pro_ser7 >;
					};

					/* ZEDX 4 Left Cam */
					zedx_left4: zedx_left_4@11 {
						status = "okay";
						def-addr = <0x11>;
						/* Define any required hw resources needed by driver */
						/* ie. clocks, io pins, power sources */
						clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
						<&bpmp TEGRA234_CLK_EXTPERIPH1>;
						clock-names = "extperiph1", "pllp_grtba";
						mclk = "extperiph1";
						zedx-id = "18";
						channel = "b";   /* deserializer channel */
						mode = "slave"; /* the master role is to initialize */
						/* all the serializers connected to the same */
						/* deserializer. -> one per ZEDX*/
						/* This master initializes the serializers */
						/* of ZEDX 0 and ZEDX 1. */
						has-eeprom;
						eeprom-addr=<0x54>;
					};
					
					/* ZEDX 4 Right Cam */
					zedx_right4: zedx_right_4@10 {
						status = "okay";
						def-addr = <0x10>;
						/* Define any required hw resources needed by driver */
						/* ie. clocks, io pins, power sources */
