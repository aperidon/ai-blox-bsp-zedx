//DTS for JETSON Nano ORIN -> Streamer

/dts-v1/;
/plugin/;

#include "aiblox-onx16-camera.dtsi"
#include "dt-bindings/clock/tegra234-clock.h"
#include "dt-bindings/gpio/tegra234-gpio.h"
#include <dt-bindings/tegra234-p3767-0000-common.h>

#define CAM0_RST_L  TEGRA234_MAIN_GPIO(H, 3)
#define CAM0_PWDN   TEGRA234_MAIN_GPIO(H, 6)
#define CAM1_RST_L  TEGRA234_MAIN_GPIO(AC, 1)
#define CAM1_PWDN   TEGRA234_MAIN_GPIO(AC, 0)
#define PWR_EN      TEGRA234_MAIN_GPIO(AC, 7)
#define CAM_I2C_MUX	TEGRA234_AON_GPIO(CC, 3)

#define CAMERA_I2C_MUX_BUS(x) (0x1E + x)

//DTS for Nano
/ {
	overlay-name = "Jetson Camera ZED-X + AI-Blox";
	jetson-header-name = "Jetson 24pin CSI Connector";
	compatible = JETSON_COMPATIBLE_P3768;

	
	fragment-camera-zedx-aiblox@0 {
		target-path = "/";
		__overlay__ {
			bus@0 {
				/* i2c-1 */
				i2c@c240000{

					max96724_a@2e {
						compatible = "stereolabs,sl_max96724";
						reg = <0x2e>;  /* deserializer i2c_address */
						channel = "a"; /* deserializer channel: one per deser */
						sync_mode = "master";
						n_lanes = "2";
						camera-serializers = <  
												&zedxone_gs_ser0 &zedxone_gs_ser1 &zedxone_gs_ser2 &zedxone_gs_ser3
												&zedxone_pro_ser0 &zedxone_pro_ser1 &zedxone_pro_ser2 &zedxone_pro_ser3 >;
						pwdn-gpio =
						<&gpio CAM0_PWDN GPIO_ACTIVE_HIGH>;
					};		
					
					max96724_b@27 {
						compatible = "stereolabs,sl_max96724";
						reg = <0x27>;  /* deserializer i2c_address */
						channel = "b"; /* deserializer channel: one per deser */
						sync_mode = "master";
						n_lanes = "2";
						camera-serializers = < 	
												&zedxone_gs_ser4 &zedxone_gs_ser5 &zedxone_gs_ser6 &zedxone_gs_ser7
												&zedxone_pro_ser4 &zedxone_pro_ser5 &zedxone_pro_ser6 &zedxone_pro_ser7 >;
						pwdn-gpio =
						<&gpio CAM0_PWDN GPIO_ACTIVE_HIGH>;
					};
				};

				/* i2c-2 */
				i2c@3180000{

				/* Channel A */

					/* ZEDX One GS 0 Cam*/
					zedxone_gs0:zedxone_gs_0@10 {
						status = "okay";
						def-addr = <0x10>;
						/* Define any required hw resources needed by driver */
						/* ie. clocks, io pins, power sources */
						clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
						<&bpmp TEGRA234_CLK_EXTPERIPH1>;
						clock-names = "extperiph1", "pllp_grtba";
						mclk = "extperiph1";
						zedx-id = "4";
						channel = "a";   /* deserializer channel */
						mode = "slave"; /* the master role is to initialize */
						/* all the serializers connected to the same */
						/* deserializer. -> one per ZEDX*/
						/* This master initializes the serializers */
						/* of ZEDX 0 and ZEDX 1. */
						eeprom-addr = <0x56>;
						has-eeprom;
					};

					/* ZEDX One GS 1 Cam*/
					zedxone_gs1:zedxone_gs_1@11 {
						status = "okay";
						def-addr = <0x11>;
						/* Define any required hw resources needed by driver */
						/* ie. clocks, io pins, power sources */
						clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
						<&bpmp TEGRA234_CLK_EXTPERIPH1>;
						clock-names = "extperiph1", "pllp_grtba";
						mclk = "extperiph1";
						zedx-id = "5";
						channel = "a";   /* deserializer channel */
						mode = "slave"; /* the master role is to initialize */
						/* all the serializers connected to the same */
						/* deserializer. -> one per ZEDX*/
						/* This master initializes the serializers */
						/* of ZEDX 0 and ZEDX 1. */
						eeprom-addr = <0x56>;
						has-eeprom;
					};

					/* ZEDX One GS 2 Cam*/
					zedxone_gs2:zedxone_gs_2@12 {
						status = "okay";
						def-addr = <0x12>;
						/* Define any required hw resources needed by driver */
						/* ie. clocks, io pins, power sources */
						clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
						<&bpmp TEGRA234_CLK_EXTPERIPH1>;
						clock-names = "extperiph1", "pllp_grtba";
						mclk = "extperiph1";
						zedx-id = "6";
						channel = "a";   /* deserializer channel */
						mode = "slave"; /* the master role is to initialize */
						/* all the serializers connected to the same */
						/* deserializer. -> one per ZEDX*/
						/* This master initializes the serializers */
						/* of ZEDX 0 and ZEDX 1. */
						eeprom-addr = <0x56>;
						has-eeprom;
					};

					/* ZEDX One GS 3 Cam*/
					zedxone_gs3:zedxone_gs_3@13 {
						status = "okay";
						def-addr = <0x13>;
						/* Define any required hw resources needed by driver */
						/* ie. clocks, io pins, power sources */
						clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
						<&bpmp TEGRA234_CLK_EXTPERIPH1>;
						clock-names = "extperiph1", "pllp_grtba";
						mclk = "extperiph1";
						zedx-id = "7";
						channel = "a";   /* deserializer channel */
						mode = "slave"; /* the master role is to initialize */
						/* all the serializers connected to the same */
						/* deserializer. -> one per ZEDX*/
						/* This master initializes the serializers */
						/* of ZEDX 0 and ZEDX 1. */
						eeprom-addr = <0x56>;
						has-eeprom;
					};

		
					/* ZEDX One pro Cam 0 */
					zedxone_pro0: zedxone_pro_0@3c {
						status = "okay";
						def-addr = <0x3c>;
						/* Define any required hw resources needed by driver */
						/* ie. clocks, io pins, power sources */
						clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
						<&bpmp TEGRA234_CLK_EXTPERIPH1>;
						clock-names = "extperiph1", "pllp_grtba";
						mclk = "extperiph1";
						channel = "a";  /* deserializer channel */
						zedx-id = "16";
						mode = "slave"; /* the serializer of the ZED is already */
						/* initialized */
						eeprom-addr = <0x52>;
						has-eeprom;
					};

					/* ZEDX One pro Cam 1 */
					zedxone_pro1: zedxone_pro_1@3d {
						status = "okay";
						def-addr = <0x3d>;
						/* Define any required hw resources needed by driver */
						/* ie. clocks, io pins, power sources */
						clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
						<&bpmp TEGRA234_CLK_EXTPERIPH1>;
						clock-names = "extperiph1", "pllp_grtba";
						mclk = "extperiph1";
						channel = "a";  /* deserializer channel */
						zedx-id = "17";
						mode = "slave"; /* the serializer of the ZED is already */
						/* initialized */
						eeprom-addr = <0x52>;
						has-eeprom;
					};

					/* ZEDX One pro Cam 2 */
					zedxone_pro2: zedxone_pro_2@3e {
						status = "okay";
						def-addr = <0x3e>;
						/* Define any required hw resources needed by driver */
						/* ie. clocks, io pins, power sources */
						clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
						<&bpmp TEGRA234_CLK_EXTPERIPH1>;
						clock-names = "extperiph1", "pllp_grtba";
						mclk = "extperiph1";
						channel = "a";  /* deserializer channel */
						zedx-id = "18";
						mode = "slave"; /* the serializer of the ZED is already */
						/* initialized */
						eeprom-addr = <0x52>;
						has-eeprom;
					};

					/* ZEDX One pro Cam 3 */
					zedxone_pro3: zedxone_pro_3@3f {
						status = "okay";
						def-addr = <0x3f>;
						/* Define any required hw resources needed by driver */
						/* ie. clocks, io pins, power sources */
						clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
						<&bpmp TEGRA234_CLK_EXTPERIPH1>;
						clock-names = "extperiph1", "pllp_grtba";
						mclk = "extperiph1";
						channel = "a";  /* deserializer channel */
						zedx-id = "19";
						mode = "slave"; /* the serializer of the ZED is already */
						/* initialized */
						eeprom-addr = <0x52>;
						has-eeprom;
					};
					

					/* Serializers */


					zedxone_gs_ser0:zedxone_gs_ser_0@20 {
						compatible = "stereolabs,sl_max9295";
						reg = <0x20>;
						channel = "a";
						camera_model = "zedonegs";
						mode = "master";
						zedx-id = "4";
						camera-sensors = <&zedxone_gs0>;
						imu = <&bmi088_a &bmi088_b &bmi088_c &bmi088_d>;
					};

					zedxone_gs_ser1:zedxone_gs_ser_1@21 {
						compatible = "stereolabs,sl_max9295";
						reg = <0x21>;
						channel = "a";
						camera_model = "zedonegs";
						mode = "master";
						zedx-id = "5";
						camera-sensors = <&zedxone_gs1>;
						imu = <&bmi088_a &bmi088_b &bmi088_c &bmi088_d>;
					};

					zedxone_gs_ser2:zedxone_gs_ser_2@22 {
						compatible = "stereolabs,sl_max9295";
						reg = <0x22>;
						channel = "a";
						camera_model = "zedonegs";
						mode = "master";
						zedx-id = "6";
						camera-sensors = <&zedxone_gs2>;
						imu = <&bmi088_a &bmi088_b &bmi088_c &bmi088_d>;
					};

					zedxone_gs_ser3:zedxone_gs_ser_3@23 {
						compatible = "stereolabs,sl_max9295";
						reg = <0x23>;
						channel = "a";
						camera_model = "zedonegs";
						mode = "master";
						zedx-id = "7";
						camera-sensors = <&zedxone_gs3>;
						imu = <&bmi088_a &bmi088_b &bmi088_c &bmi088_d>;
					};


					zedxone_pro_ser0: zedxone_pro_ser_0@4c {
						compatible = "stereolabs,sl_max9295";
						reg = <0x4c>;
						channel = "a";
						camera_model = "zedonepro";
						mode = "master";
						zedx-id = "16";
						camera-sensors = <&zedxone_pro0>;
						imu = <&bmi088_a &bmi088_b &bmi088_c &bmi088_d>;

					};

					zedxone_pro_ser1: zedxone_pro_ser_1@4d {
						compatible = "stereolabs,sl_max9295";
						reg = <0x4d>;
						channel = "a";
						camera_model = "zedonepro";
						mode = "master";
						zedx-id = "17";
						camera-sensors = <&zedxone_pro1>;
						imu = <&bmi088_a &bmi088_b &bmi088_c &bmi088_d>;

					};

					zedxone_pro_ser2: zedxone_pro_ser_2@4e {
						compatible = "stereolabs,sl_max9295";
						reg = <0x4e>;
						channel = "a";
						camera_model = "zedonepro";
						mode = "master";
						zedx-id = "18";
						camera-sensors = <&zedxone_pro2>;
						imu = <&bmi088_a &bmi088_b &bmi088_c &bmi088_d>;

					};

					zedxone_pro_ser3: zedxone_pro_ser_3@4f {
						compatible = "stereolabs,sl_max9295";
						reg = <0x4f>;
						channel = "a";
						camera_model = "zedonepro";
						mode = "master";
						zedx-id = "19";
						camera-sensors = <&zedxone_pro3>;
						imu = <&bmi088_a &bmi088_b &bmi088_c &bmi088_d>;

					};

					/* IMU A*/
					bmi088_a: bmi088_a_@60 {
						//compatible = "bmi,bmi088";
						reg = <0x60>; /* <-- Must be gyroscope I2C address */
						accel_i2c_addr = <0x70>; /* Must be specified */
						accel_matrix    = [01 00 00 00 01 00 00 00 01];
						gyro_matrix        = [01 00 00 00 01 00 00 00 01];
					};

					/* IMU B*/
					bmi088_b: bmi088_b_@61 {
						//compatible = "bmi,bmi088";
						reg = <0x61>; /* <-- Must be gyroscope I2C address */
						accel_i2c_addr = <0x71>; /* Must be specified */
						accel_matrix    = [01 00 00 00 01 00 00 00 01];
						gyro_matrix        = [01 00 00 00 01 00 00 00 01];
					};

					/* IMU C*/
					bmi088_c: bmi088_c_@62 {
						//compatible = "bmi,bmi088";
						reg = <0x62>; /* <-- Must be gyroscope I2C address */
						accel_i2c_addr = <0x72>; /* Must be specified */
						accel_matrix    = [01 00 00 00 01 00 00 00 01];
						gyro_matrix        = [01 00 00 00 01 00 00 00 01];
					};

					/* IMU D*/
					bmi088_d: bmi088_d_@63 {
						//compatible = "bmi,bmi088";
						reg = <0x63>; /* <-- Must be gyroscope I2C address */
						accel_i2c_addr = <0x73>; /* Must be specified */
						accel_matrix    = [01 00 00 00 01 00 00 00 01];
						gyro_matrix        = [01 00 00 00 01 00 00 00 01];
					};

				/* Channel B */

					/* ZEDX One GS 4 Cam*/
					zedxone_gs4:zedxone_gs_4@30 {
						status = "okay";
						def-addr = <0x30>;
						/* Define any required hw resources needed by driver */
						/* ie. clocks, io pins, power sources */
						clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
						<&bpmp TEGRA234_CLK_EXTPERIPH1>;
						clock-names = "extperiph1", "pllp_grtba";
						mclk = "extperiph1";
						zedx-id = "24";
						channel = "b";   /* deserializer channel */
						mode = "slave"; /* the master role is to initialize */
						/* all the serializers connected to the same */
						/* deserializer. -> one per ZEDX*/
						/* This master initializes the serializers */
						/* of ZEDX 0 and ZEDX 1. */
						eeprom-addr = <0x56>;
						has-eeprom;
					};

					/* ZEDX One GS 5 Cam*/
					zedxone_gs5:zedxone_gs_5@31 {
						status = "okay";
						def-addr = <0x31>;
						/* Define any required hw resources needed by driver */
						/* ie. clocks, io pins, power sources */
						clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
						<&bpmp TEGRA234_CLK_EXTPERIPH1>;
						clock-names = "extperiph1", "pllp_grtba";
						mclk = "extperiph1";
						zedx-id = "25";
						channel = "b";   /* deserializer channel */
						mode = "slave"; /* the master role is to initialize */
						/* all the serializers connected to the same */
						/* deserializer. -> one per ZEDX*/
						/* This master initializes the serializers */
						/* of ZEDX 0 and ZEDX 1. */
						eeprom-addr = <0x56>;
						has-eeprom;
					};

					/* ZEDX One GS 6 Cam*/
					zedxone_gs6:zedxone_gs_6@32 {
						status = "okay";
						def-addr = <0x32>;
						/* Define any required hw resources needed by driver */
						/* ie. clocks, io pins, power sources */
						clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
						<&bpmp TEGRA234_CLK_EXTPERIPH1>;
						clock-names = "extperiph1", "pllp_grtba";
						mclk = "extperiph1";
						zedx-id = "26";
						channel = "b";   /* deserializer channel */
						mode = "slave"; /* the master role is to initialize */
						/* all the serializers connected to the same */
						/* deserializer. -> one per ZEDX*/
						/* This master initializes the serializers */
						/* of ZEDX 0 and ZEDX 1. */
						eeprom-addr = <0x56>;
						has-eeprom;
					};

					/* ZEDX One GS 7 Cam*/
					zedxone_gs7:zedxone_gs_7@33 {
						status = "okay";
						def-addr = <0x33>;
						/* Define any required hw resources needed by driver */
						/* ie. clocks, io pins, power sources */
						clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
						<&bpmp TEGRA234_CLK_EXTPERIPH1>;
						clock-names = "extperiph1", "pllp_grtba";
						mclk = "extperiph1";
						zedx-id = "27";
						channel = "b";   /* deserializer channel */
						mode = "slave"; /* the master role is to initialize */
						/* all the serializers connected to the same */
						/* deserializer. -> one per ZEDX*/
						/* This master initializes the serializers */
						/* of ZEDX 0 and ZEDX 1. */
						eeprom-addr = <0x56>;
						has-eeprom;
					};


					/* ZEDX One pro Cam 4 */
					zedxone_pro4: zedxone_pro_4@5c {
						status = "okay";
						def-addr = <0x5c>;
						/* Define any required hw resources needed by driver */
						/* ie. clocks, io pins, power sources */
						clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
						<&bpmp TEGRA234_CLK_EXTPERIPH1>;
						clock-names = "extperiph1", "pllp_grtba";
						mclk = "extperiph1";
						channel = "b";  /* deserializer channel */
						zedx-id = "36";
						mode = "slave"; /* the serializer of the ZED is already */
						/* initialized */
						eeprom-addr = <0x52>;
						has-eeprom;
					};

					/* ZEDX One pro Cam 5 */
					zedxone_pro5: zedxone_pro_5@5d {
						status = "okay";
						def-addr = <0x5d>;
						/* Define any required hw resources needed by driver */
						/* ie. clocks, io pins, power sources */
						clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
						<&bpmp TEGRA234_CLK_EXTPERIPH1>;
						clock-names = "extperiph1", "pllp_grtba";
						mclk = "extperiph1";
						channel = "b";  /* deserializer channel */
						zedx-id = "37";
						mode = "slave"; /* the serializer of the ZED is already */
						/* initialized */
						eeprom-addr = <0x52>;
						has-eeprom;
					};

					/* ZEDX One pro Cam 6 */
					zedxone_pro6: zedxone_pro_6@5e {
						status = "okay";
						def-addr = <0x5e>;
						/* Define any required hw resources needed by driver */
						/* ie. clocks, io pins, power sources */
						clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
						<&bpmp TEGRA234_CLK_EXTPERIPH1>;
						clock-names = "extperiph1", "pllp_grtba";
						mclk = "extperiph1";
						channel = "b";  /* deserializer channel */
						zedx-id = "38";
						mode = "slave"; /* the serializer of the ZED is already */
						/* initialized */
						eeprom-addr = <0x52>;
						has-eeprom;
					};

					/* ZEDX One pro Cam 7 */
					zedxone_pro7: zedxone_pro_7@5f {
						status = "okay";
						def-addr = <0x5f>;
						/* Define any required hw resources needed by driver */
						/* ie. clocks, io pins, power sources */
						clocks = <&bpmp TEGRA234_CLK_EXTPERIPH1>,
						<&bpmp TEGRA234_CLK_EXTPERIPH1>;
						clock-names = "extperiph1", "pllp_grtba";
						mclk = "extperiph1";
						channel = "b";  /* deserializer channel */
						zedx-id = "39";
						mode = "slave"; /* the serializer of the ZED is already */
						/* initialized */
						eeprom-addr = <0x52>;
						has-eeprom;
					};
					

					/* Serializers */

					zedxone_gs_ser4:zedxone_gs_ser_4@40 {
						compatible = "stereolabs,sl_max9295";
						reg = <0x40>;
						channel = "b";
						camera_model = "zedonegs";
						mode = "master";
						zedx-id = "24";
						camera-sensors = <&zedxone_gs4>;
						imu = <&bmi088_e &bmi088_f &bmi088_g &bmi088_h>;
					};

					zedxone_gs_ser5:zedxone_gs_ser_5@41 {
						compatible = "stereolabs,sl_max9295";
						reg = <0x41>;
						channel = "b";
						camera_model = "zedonegs";
						mode = "master";
						zedx-id = "25";
						camera-sensors = <&zedxone_gs5>;
						imu = <&bmi088_e &bmi088_f &bmi088_g &bmi088_h>;
					};

					zedxone_gs_ser6:zedxone_gs_ser_6@42 {
						compatible = "stereolabs,sl_max9295";
						reg = <0x42>;
						channel = "b";
						camera_model = "zedonegs";
						mode = "master";
						zedx-id = "26";
						camera-sensors = <&zedxone_gs6>;
						imu = <&bmi088_e &bmi088_f &bmi088_g &bmi088_h>;
					};

					zedxone_gs_ser7:zedxone_gs_ser_7@43 {
						compatible = "stereolabs,sl_max9295";
						reg = <0x43>;
						channel = "b";
						camera_model = "zedonegs";
						mode = "master";
						zedx-id = "27";
						camera-sensors = <&zedxone_gs7>;
						imu = <&bmi088_e &bmi088_f &bmi088_g &bmi088_h>;
					};


					zedxone_pro_ser4: zedxone_pro_ser_4@6c {
						compatible = "stereolabs,sl_max9295";
						reg = <0x6c>;
						channel = "b";
						camera_model = "zedonepro";
						mode = "master";
						zedx-id = "36";
						camera-sensors = <&zedxone_pro4>;
						imu = <&bmi088_e &bmi088_f &bmi088_g &bmi088_h>;

					};

					zedxone_pro_ser5: zedxone_pro_ser_5@6d {
						compatible = "stereolabs,sl_max9295";
						reg = <0x6d>;
						channel = "b";
						camera_model = "zedonepro";
						mode = "master";
						zedx-id = "37";
						camera-sensors = <&zedxone_pro5>;
						imu = <&bmi088_e &bmi088_f &bmi088_g &bmi088_h>;

					};

					zedxone_pro_ser6: zedxone_pro_ser_6@6e {
						compatible = "stereolabs,sl_max9295";
						reg = <0x6e>;
						channel = "b";
						camera_model = "zedonepro";
						mode = "master";
						zedx-id = "38";
						camera-sensors = <&zedxone_pro6>;
						imu = <&bmi088_e &bmi088_f &bmi088_g &bmi088_h>;

					};

					zedxone_pro_ser7: zedxone_pro_ser_7@6f {
						compatible = "stereolabs,sl_max9295";
						reg = <0x6f>;
						channel = "b";
						camera_model = "zedonepro";
						mode = "master";
						zedx-id = "39";
						camera-sensors = <&zedxone_pro7>;
						imu = <&bmi088_e &bmi088_f &bmi088_g &bmi088_h>;

					};


					/* IMU A*/
					bmi088_e: bmi088_e_@64 {
						//compatible = "bmi,bmi088";
						reg = <0x64>; /* <-- Must be gyroscope I2C address */
						accel_i2c_addr = <0x74>; /* Must be specified */
						accel_matrix    = [01 00 00 00 01 00 00 00 01];
						gyro_matrix        = [01 00 00 00 01 00 00 00 01];
					};

					/* IMU B*/
					bmi088_f: bmi088_f_@65 {
						//compatible = "bmi,bmi088";
						reg = <0x65>; /* <-- Must be gyroscope I2C address */
						accel_i2c_addr = <0x75>; /* Must be specified */
						accel_matrix    = [01 00 00 00 01 00 00 00 01];
						gyro_matrix        = [01 00 00 00 01 00 00 00 01];
					};

					/* IMU C*/
					bmi088_g: bmi088_g_@66 {
						//compatible = "bmi,bmi088";
						reg = <0x66>; /* <-- Must be gyroscope I2C address */
						accel_i2c_addr = <0x76>; /* Must be specified */
						accel_matrix    = [01 00 00 00 01 00 00 00 01];
						gyro_matrix        = [01 00 00 00 01 00 00 00 01];
					};

					/* IMU D*/
					bmi088_h: bmi088_h_@67 {
						//compatible = "bmi,bmi088";
						reg = <0x67>; /* <-- Must be gyroscope I2C address */
						accel_i2c_addr = <0x77>; /* Must be specified */
						accel_matrix    = [01 00 00 00 01 00 00 00 01];
						gyro_matrix        = [01 00 00 00 01 00 00 00 01];
					};
					
				};
			};
		};
	};
};

