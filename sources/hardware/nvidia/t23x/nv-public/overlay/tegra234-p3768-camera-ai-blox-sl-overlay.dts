//DTS for JETSON Nano ORIN -> Streamer

/dts-v1/;
/plugin/;

#include "aiblox-onx16-camera.dtsi"
#include "Utils/camera-clks.dtsi"
#include "dt-bindings/clock/tegra234-clock.h"
#include "dt-bindings/gpio/tegra234-gpio.h"
#include <dt-bindings/tegra234-p3767-0000-common.h>

#define CAM0_RST_L  TEGRA234_MAIN_GPIO(H, 3)
#define CAM0_PWDN   TEGRA234_MAIN_GPIO(H, 6)
#define CAM1_RST_L  TEGRA234_MAIN_GPIO(AC, 1)
#define CAM1_PWDN   TEGRA234_MAIN_GPIO(AC, 0)
#define PWR_EN      TEGRA234_MAIN_GPIO(AC, 7)
#define CAM_I2C_MUX	TEGRA234_AON_GPIO(CC, 3)

#define CAMERA_I2C_MUX_BUS(x) (0x1E + x)

//DTS for Nano
/ {
	overlay-name = "Jetson Camera ZED-X + AI-Blox";
	jetson-header-name = "Jetson 24pin CSI Connector";
	compatible = JETSON_COMPATIBLE_P3768;
	
	
	fragment-camera-zedx-aiblox@0 {
		target-path = "/";
		__overlay__ {
			bus@0 {
				/* i2c-1 */
				i2c@c240000{
					
					max96724_a@2e {
						compatible = "stereolabs,sl_max96724";
						reg = <0x2e>;  /* deserializer i2c_address */
						channel = "a"; /* deserializer channel: one per deser */
						pwdn-gpio =	<&gpio CAM0_PWDN GPIO_ACTIVE_HIGH>;
						
						camera-serializers = <
						/* GMSL 0 */&zedxone_gs_ser0 &zedxone_hdr_ser0
						/* GMSL 1 */&zedxone_gs_ser1 &zedxone_hdr_ser1
						/* GMSL 2 */&zedxone_gs_ser2 &zedxone_hdr_ser2
						/* GMSL 3 */&zedxone_gs_ser3 &zedxone_hdr_ser3 >;
						
					};
					
					max96724_b@27 {
						compatible = "stereolabs,sl_max96724";
						reg = <0x27>;  /* deserializer i2c_address */
						channel = "b"; /* deserializer channel: one per deser */
						pwdn-gpio =	<&gpio CAM0_PWDN GPIO_ACTIVE_HIGH>;
						
						camera-serializers = <
						/* GMSL 0 */&zedxone_gs_ser4 &zedxone_hdr_ser4
						/* GMSL 1 */&zedxone_gs_ser5 &zedxone_hdr_ser5
						/* GMSL 2 */&zedxone_gs_ser6 &zedxone_hdr_ser6
						/* GMSL 3 */&zedxone_gs_ser7 &zedxone_hdr_ser7 >;
					};
				};
				
				/* i2c-2 */
				i2c@3180000{
					
					/* Channel A */
					
					/* ZEDX One GS 0 Cam */
					zedxone_gs0: zedxone_gs_0@10 {
						compatible = "stereolabs,zedx";
						reg = <0x10>;
						
						ZED_ORIN_CLKS
						
						zedx-id = "0";
						channel = "a"; /* deserializer channel */
						
						has-eeprom;
						eeprom-addr=<0x56>;
					};
					
					/* ZEDX One GS 1 Cam */
					zedxone_gs1: zedxone_gs_1@11 {
						compatible = "stereolabs,zedx";
						reg = <0x11>;
						
						ZED_ORIN_CLKS
						
						zedx-id = "1";
						channel = "a"; /* deserializer channel */
						
						has-eeprom;
						eeprom-addr=<0x56>;
					};
					
					/* ZEDX One GS 2 Cam */
					zedxone_gs2: zedxone_gs_2@12 {
						compatible = "stereolabs,zedx";
						reg = <0x12>;
						
						ZED_ORIN_CLKS
						
						zedx-id = "2";
						channel = "a";   /* deserializer channel */
						
						has-eeprom;
						eeprom-addr=<0x56>;
					};
					
					/* ZEDX One GS 3 Cam */
					zedxone_gs3: zedxone_gs_3@13 {
						compatible = "stereolabs,zedx";
						reg = <0x13>;
						
						ZED_ORIN_CLKS
						
						zedx-id = "3";
						channel = "a";   /* deserializer channel */
						
						has-eeprom;
						eeprom-addr=<0x56>;
					};
					
					/* ZEDX One pro Cam 0 */
					zedxone_hdr0: zedxone_hdr_0@3c {
						compatible = "stereolabs,zedxhdr";
						reg = <0x3c>;
						
						ZED_ORIN_CLKS
						
						zedx-id = "4";
						channel = "a";  /* deserializer channel */
						
						has-eeprom;
						eeprom-addr = <0x52>;
					};
					
					/* ZEDX One pro Cam 1 */
					zedxone_hdr1: zedxone_hdr_1@3d {
						compatible = "stereolabs,zedxhdr";
						reg = <0x3d>;
						
						ZED_ORIN_CLKS
						
						zedx-id = "5";
						channel = "a";  /* deserializer channel */
						
						has-eeprom;
						eeprom-addr = <0x52>;
					};
					
					/* ZEDX One pro Cam 2 */
					zedxone_hdr2: zedxone_hdr_2@3e {
						compatible = "stereolabs,zedxhdr";
						reg = <0x3e>;
						
						ZED_ORIN_CLKS
						
						channel = "a";  /* deserializer channel */
						zedx-id = "6";
						
						has-eeprom;
						eeprom-addr = <0x52>;
					};
					
					/* ZEDX One pro Cam 3 */
					zedxone_hdr3: zedxone_hdr_3@3f {
						compatible = "stereolabs,zedxhdr";
						reg = <0x3f>;
						
						ZED_ORIN_CLKS
						
						zedx-id = "7";
						channel = "a";  /* deserializer channel */
						
						has-eeprom;
						eeprom-addr = <0x52>;
					};
					
					
					/* Serializers */
					
					
					zedxone_gs_ser0: zedxone_gs_ser_0@20 {
						compatible = "stereolabs,sl_max9295";
						reg = <0x20>;
						
						zedx-id = "0";
						channel = "a";
						mode = "master";
						
						camera_model = "zedonegs";
						camera-sensors = <&zedxone_gs0>;
						imu = <&bmi088_a &bmi088_b &bmi088_c &bmi088_d>;
					};
					
					zedxone_gs_ser1: zedxone_gs_ser_1@21 {
						compatible = "stereolabs,sl_max9295";
						reg = <0x21>;
						
						zedx-id = "1";
						channel = "a";
						mode = "master";
						
						camera_model = "zedonegs";
						camera-sensors = <&zedxone_gs1>;
						imu = <&bmi088_a &bmi088_b &bmi088_c &bmi088_d>;
					};
					
					zedxone_gs_ser2: zedxone_gs_ser_2@22 {
						compatible = "stereolabs,sl_max9295";
						reg = <0x22>;
						
						zedx-id = "2";
						channel = "a";
						mode = "master";
						
						camera_model = "zedonegs";
						camera-sensors = <&zedxone_gs2>;
						imu = <&bmi088_a &bmi088_b &bmi088_c &bmi088_d>;
					};
					
					zedxone_gs_ser3: zedxone_gs_ser_3@23 {
						compatible = "stereolabs,sl_max9295";
						reg = <0x23>;
						
						zedx-id = "3";
						channel = "a";
						mode = "master";
						
						camera_model = "zedonegs";
						camera-sensors = <&zedxone_gs3>;
						imu = <&bmi088_a &bmi088_b &bmi088_c &bmi088_d>;
					};
					
					
					zedxone_hdr_ser0: zedxone_hdr_ser_0@4c {
						compatible = "stereolabs,sl_max9295";
						reg = <0x4c>;
						
						zedx-id = "4";
						channel = "a";
						mode = "master";
						
						camera_model = "zedonehdr";
						camera-sensors = <&zedxone_hdr0>;
						imu = <&bmi088_a &bmi088_b &bmi088_c &bmi088_d>;
					};
					
					zedxone_hdr_ser1: zedxone_hdr_ser_1@4d {
						compatible = "stereolabs,sl_max9295";
						reg = <0x4d>;
						
						zedx-id = "5";
						channel = "a";
						mode = "master";
						
						camera_model = "zedonehdr";
						camera-sensors = <&zedxone_hdr1>;
						imu = <&bmi088_a &bmi088_b &bmi088_c &bmi088_d>;
						
					};
					
					zedxone_hdr_ser2: zedxone_hdr_ser_2@4e {
						compatible = "stereolabs,sl_max9295";
						reg = <0x4e>;
						
						zedx-id = "6";
						channel = "a";
						mode = "master";
						
						camera_model = "zedonehdr";
						camera-sensors = <&zedxone_hdr2>;
						imu = <&bmi088_a &bmi088_b &bmi088_c &bmi088_d>;
					};
					
					zedxone_hdr_ser3: zedxone_hdr_ser_3@4f {
						compatible = "stereolabs,sl_max9295";
						reg = <0x4f>;
						
						zedx-id = "7";
						channel = "a";
						mode = "master";
						
						camera_model = "zedonehdr";
						camera-sensors = <&zedxone_hdr3>;
						imu = <&bmi088_a &bmi088_b &bmi088_c &bmi088_d>;
					};
					
					/* IMU A*/
					bmi088_a: bmi088_a_@60 {
						compatible = "bmi,bmi088";
						reg = <0x60>; /* <-- Must be gyroscope I2C address */
						accel_i2c_addr = <0x70>; /* Must be specified */
						accel_matrix    = [01 00 00 00 01 00 00 00 01];
						gyro_matrix        = [01 00 00 00 01 00 00 00 01];
					};
					
					/* IMU B*/
					bmi088_b: bmi088_b_@61 {
						compatible = "bmi,bmi088";
						reg = <0x61>; /* <-- Must be gyroscope I2C address */
						accel_i2c_addr = <0x71>; /* Must be specified */
						accel_matrix    = [01 00 00 00 01 00 00 00 01];
						gyro_matrix        = [01 00 00 00 01 00 00 00 01];
					};
					
					/* IMU C*/
					bmi088_c: bmi088_c_@62 {
						compatible = "bmi,bmi088";
						reg = <0x62>; /* <-- Must be gyroscope I2C address */
						accel_i2c_addr = <0x72>; /* Must be specified */
						accel_matrix    = [01 00 00 00 01 00 00 00 01];
						gyro_matrix        = [01 00 00 00 01 00 00 00 01];
					};
					
					/* IMU D*/
					bmi088_d: bmi088_d_@63 {
						compatible = "bmi,bmi088";
						reg = <0x63>; /* <-- Must be gyroscope I2C address */
						accel_i2c_addr = <0x73>; /* Must be specified */
						accel_matrix    = [01 00 00 00 01 00 00 00 01];
						gyro_matrix        = [01 00 00 00 01 00 00 00 01];
					};
					
					/* Channel B */
					
					/* ZEDX One GS 4 Cam */
					zedxone_gs4: zedxone_gs_4@30 {
						compatible = "stereolabs,zedx";
						reg = <0x30>;
						
						ZED_ORIN_CLKS
						
						zedx-id = "8";
						channel = "b";   /* deserializer channel */
						
						has-eeprom;
						eeprom-addr=<0x56>;
					};
					
					/* ZEDX One GS 5 Cam */
					zedxone_gs5: zedxone_gs_5@31 {
						compatible = "stereolabs,zedx";
						reg = <0x31>;
						
						ZED_ORIN_CLKS
						
						zedx-id = "9";
						channel = "b";   /* deserializer channel */
						
						has-eeprom;
						eeprom-addr=<0x56>;
					};
					
					/* ZEDX One GS 6 Cam */
					zedxone_gs6: zedxone_gs_6@32 {
						compatible = "stereolabs,zedx";
						reg = <0x32>;
						
						ZED_ORIN_CLKS
						
						zedx-id = "10";
						channel = "b";   /* deserializer channel */
						
						has-eeprom;
						eeprom-addr=<0x56>;
					};
					
					/* ZEDX One GS 3 Cam */
					zedxone_gs7: zedxone_gs_7@33 {
						compatible = "stereolabs,zedx";
						reg = <0x33>;
						
						ZED_ORIN_CLKS
						
						zedx-id = "11";
						channel = "b";   /* deserializer channel */
						
						has-eeprom;
						eeprom-addr=<0x56>;
					};
					
					/* ZEDX One pro Cam 4 */
					zedxone_hdr4: zedxone_hdr_4@5c {
						compatible = "stereolabs,zedxhdr";
						reg = <0x5c>;
						
						ZED_ORIN_CLKS
						
						zedx-id = "12";
						channel = "b";  /* deserializer channel */
						
						eeprom-addr = <0x52>;
						has-eeprom;
					};
					
					/* ZEDX One pro Cam 5 */
					zedxone_hdr5: zedxone_hdr_5@5d {
						compatible = "stereolabs,zedxhdr";
						reg = <0x5d>;
						
						ZED_ORIN_CLKS
						
						zedx-id = "13";
						channel = "b";  /* deserializer channel */
						
						has-eeprom;
						eeprom-addr = <0x52>;
					};
					
					/* ZEDX One pro Cam 6 */
					zedxone_hdr6: zedxone_hdr_6@5e {
						compatible = "stereolabs,zedxhdr";
						reg = <0x5e>;
						
						ZED_ORIN_CLKS
						
						zedx-id = "14";
						channel = "b";  /* deserializer channel */
						
						eeprom-addr = <0x52>;
						has-eeprom;
					};
					
					/* ZEDX One pro Cam 7 */
					zedxone_hdr7: zedxone_hdr_7@5f {
						compatible = "stereolabs,zedxhdr";
						reg = <0x5f>;
						
						ZED_ORIN_CLKS
						
						zedx-id = "15";
						channel = "b";  /* deserializer channel */
						
						has-eeprom;
						eeprom-addr = <0x52>;
					};
					
					/* Serializers */
					
					zedxone_gs_ser4: zedxone_gs_ser_4@43 {
						compatible = "stereolabs,sl_max9295";
						reg = <0x43>;
						
						zedx-id = "8";
						channel = "b";
						mode = "master";
						
						camera_model = "zedonegs";
						camera-sensors = <&zedxone_gs4>;
						imu = <&bmi088_e &bmi088_f &bmi088_g &bmi088_h>;
					};
					
					zedxone_gs_ser5: zedxone_gs_ser_5@44 {
						compatible = "stereolabs,sl_max9295";
						reg = <0x44>;
						
						zedx-id = "9";
						channel = "b";
						mode = "master";
						
						camera_model = "zedonegs";
						camera-sensors = <&zedxone_gs5>;
						imu = <&bmi088_e &bmi088_f &bmi088_g &bmi088_h>;
					};
					
					zedxone_gs_ser6: zedxone_gs_ser_6@45  {
						compatible = "stereolabs,sl_max9295";
						reg = <0x45>;
						
						zedx-id = "10";
						channel = "b";
						mode = "master";
						
						camera_model = "zedonegs";
						camera-sensors = <&zedxone_gs6>;
						imu = <&bmi088_e &bmi088_f &bmi088_g &bmi088_h>;
					};
					
					zedxone_gs_ser7: zedxone_gs_ser_7@46 {
						compatible = "stereolabs,sl_max9295";
						reg = <0x46>;
						
						zedx-id = "11";
						channel = "b";
						mode = "master";
						
						camera_model = "zedonegs";
						camera-sensors = <&zedxone_gs7>;
						imu = <&bmi088_e &bmi088_f &bmi088_g &bmi088_h>;
					};
					
					
					zedxone_hdr_ser4: zedxone_hdr_ser_4@6c {
						compatible = "stereolabs,sl_max9295";
						reg = <0x6c>;
						
						zedx-id = "12";
						channel = "b";
						mode = "master";
						
						camera_model = "zedonehdr";
						camera-sensors = <&zedxone_hdr4>;
						imu = <&bmi088_e &bmi088_f &bmi088_g &bmi088_h>;
					};
					
					zedxone_hdr_ser5: zedxone_hdr_ser_5@6d {
						compatible = "stereolabs,sl_max9295";
						reg = <0x6d>;
						
						zedx-id = "13";
						channel = "b";
						mode = "master";
						
						camera_model = "zedonehdr";
						camera-sensors = <&zedxone_hdr5>;
						imu = <&bmi088_e &bmi088_f &bmi088_g &bmi088_h>;
					};
					
					zedxone_hdr_ser6: zedxone_hdr_ser_6@6e {
						compatible = "stereolabs,sl_max9295";
						reg = <0x6e>;
						
						zedx-id = "14";
						channel = "b";
						mode = "master";
						
						camera_model = "zedonehdr";
						camera-sensors = <&zedxone_hdr6>;
						imu = <&bmi088_e &bmi088_f &bmi088_g &bmi088_h>;
					};
					
					zedxone_hdr_ser7: zedxone_hdr_ser_7@6f {
						compatible = "stereolabs,sl_max9295";
						reg = <0x6f>;
						
						zedx-id = "15";
						channel = "b";
						mode = "master";
						
						camera_model = "zedonehdr";
						camera-sensors = <&zedxone_hdr7>;
						imu = <&bmi088_e &bmi088_f &bmi088_g &bmi088_h>;
					};
					
					
					/* IMU A*/
					bmi088_e: bmi088_e_@64 {
						compatible = "bmi,bmi088";
						reg = <0x64>; /* <-- Must be gyroscope I2C address */
						accel_i2c_addr = <0x74>; /* Must be specified */
						accel_matrix    = [01 00 00 00 01 00 00 00 01];
						gyro_matrix        = [01 00 00 00 01 00 00 00 01];
					};
					
					/* IMU B*/
					bmi088_f: bmi088_f_@65 {
						compatible = "bmi,bmi088";
						reg = <0x65>; /* <-- Must be gyroscope I2C address */
						accel_i2c_addr = <0x75>; /* Must be specified */
						accel_matrix    = [01 00 00 00 01 00 00 00 01];
						gyro_matrix        = [01 00 00 00 01 00 00 00 01];
					};
					
					/* IMU C*/
					bmi088_g: bmi088_g_@66 {
						compatible = "bmi,bmi088";
						reg = <0x66>; /* <-- Must be gyroscope I2C address */
						accel_i2c_addr = <0x76>; /* Must be specified */
						accel_matrix    = [01 00 00 00 01 00 00 00 01];
						gyro_matrix        = [01 00 00 00 01 00 00 00 01];
					};
					
					/* IMU D*/
					bmi088_h: bmi088_h_@67 {
						compatible = "bmi,bmi088";
						reg = <0x67>; /* <-- Must be gyroscope I2C address */
						accel_i2c_addr = <0x77>; /* Must be specified */
						accel_matrix    = [01 00 00 00 01 00 00 00 01];
						gyro_matrix        = [01 00 00 00 01 00 00 00 01];
					};
					
				};
			};
		};
	};
};

