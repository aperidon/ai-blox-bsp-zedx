# See: man pkg-config
prefix=/sources/buildroot-source_toolchains.bootlin.com-2022.08.1/aarch64--glibc--stable-2022.08-1
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: Python
Description: Build a C extension for Python
Requires:
Version: 3.10
Libs.private: -lcrypt -lpthread -ldl  -lutil -lm
Libs:
Cflags: -I${includedir}/python3.10
