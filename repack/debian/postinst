#!/bin/bash

# set -x

pushd /boot/extlinux &> /dev/null
sync
EXTLINUX=$(ls extlinux.conf)

if [ -n "${EXTLINUX}" ]; then

	if [ ! -e ${EXTLINUX}.sl-backup ]; then

		cp ${EXTLINUX} ${EXTLINUX}.sl-backup

		sync

	fi

	if [ ! -f "/etc/nv_tegra_release" ]; then
		echo "File not found: /etc/nv_tegra_release"
		exit 1
	fi

	l4t_version=$(grep -oP 'R\K[0-9]+' "/etc/nv_tegra_release" | head -1)
	l4t_minor=$(grep -oP ': \K[0-9]+' "/etc/nv_tegra_release" | head -1)
	l4t_rev=$(grep -oP ': \K[0-9].\K[0-9]' "/etc/nv_tegra_release" | head -1)


	## Get current DTB in /boot/dtb/
	board=$(ls /boot/dtb/kernel_* | awk -F"." '{print $1}' | awk -F"_" '{print $NF}' | awk -F"-" '{print $2}')
	teg_version=$(ls /boot/dtb/kernel_* | awk -F"." '{print $1}' | awk -F"_" '{print $NF}' | awk -F"-" '{print $1}')
	if [ -z "$board" ] ## fallback to /boot/kernel_*
	then
		board=$(ls /boot/kernel_* | awk -F"." '{print $1}' | awk -F"_" '{print $NF}' | awk -F"-" '{print $2}')
		teg_version=$(ls /boot/kernel_* | awk -F"." '{print $1}' | awk -F"_" '{print $NF}' | awk -F"-" '{print $1}')
	fi
	extension=$teg_version-$board
	echo "Detected DTB to update : $extension"
	value=$(</boot/stereolabs/utils/zlconfig)
	echo "Detected capture card : $value"
	sudo python3 /boot/stereolabs/utils/extlinux.py $value
	RC=$?


	if (( $RC != 0 )); then
		echo "[Error] Fail to update extlinux.conf. This Will require a custom configuration."
		sudo cp "${EXTLINUX}.sl-backup" ${EXTLINUX}
	fi


	sync

	popd &> /dev/null
fi

## Update isp config
sudo chmod 664 /var/nvidia/nvcam/settings/zedx_ar0234.isp
sudo chown root:root /var/nvidia/nvcam/settings/zedx_ar0234.isp

## Udpate Daemon and argus
## modify argus daemon to avoid timeout when using multiple cameras
sudo sed -i '/^\[Service\]$/ a Environment="enableCamInfiniteTimeout=1"' /etc/systemd/system/nvargus-daemon.service

if [[ $l4t_version -eq 36 && $l4t_minor -eq 4 ]]; then
	cp /usr/lib/aarch64-linux-gnu/tegra/libnvisppg.so /usr/lib/aarch64-linux-gnu/tegra/libnvisppg.so.sl-backup
	if [ $l4t_rev -eq 3 ]; then 
		mv /tmp/R36.4.3/libnvisppg.so /usr/lib/aarch64-linux-gnu/tegra/libnvisppg.so
	elif [ $l4t_rev -eq 0 ]; then 
		mv /tmp/R36.4.0/libnvisppg.so /usr/lib/aarch64-linux-gnu/tegra/libnvisppg.so
	else
		if [ $l4t_rev -lt 3 ]; then
			echo "Failed to patch nvargus : Please update your system with : 'sudo apt update && sudo apt upgrade'"
		fi
	fi

	## Backup and update NVIDIA capture/IVC modules
	MODULES_BASE="/lib/modules/$(uname -r)/updates"

	CAPTURE_IVC_PATH="$MODULES_BASE/drivers/platform/tegra/rtcpu/capture-ivc.ko"
	NVHOST_VI5_PATH="$MODULES_BASE/drivers/video/tegra/host/vi/nvhost-vi5.ko"

	# Backup originals once
	if [[ -f "$CAPTURE_IVC_PATH" && ! -f "${CAPTURE_IVC_PATH}.sl-backup" ]]; then
		cp "$CAPTURE_IVC_PATH" "${CAPTURE_IVC_PATH}.sl-backup"
	fi
	if [[ -f "$NVHOST_VI5_PATH" && ! -f "${NVHOST_VI5_PATH}.sl-backup" ]]; then
		cp "$NVHOST_VI5_PATH" "${NVHOST_VI5_PATH}.sl-backup"
	fi

	# Replace with patched modules from /tmp/nvidia-capture-patches if present
	if [[ -f "/tmp/nvidia-capture-patches/capture-ivc.ko" ]]; then
		mv "/tmp/nvidia-capture-patches/capture-ivc.ko" "$CAPTURE_IVC_PATH"
	fi

	if [[ -f "/tmp/nvidia-capture-patches/nvhost-vi5.ko" ]]; then
		mv "/tmp/nvidia-capture-patches/nvhost-vi5.ko" "$NVHOST_VI5_PATH"
	fi
fi

## Move service from /tmp/ to /etc/systemd/system
mv /tmp/zed_x_daemon.service /etc/systemd/system/zed_x_daemon.service
mv /tmp/driver_zed_loader.service /etc/systemd/system/driver_zed_loader.service
mv /tmp/IMU_Daemon.service /etc/systemd/system/IMU_Daemon.service
## enable service
sudo systemctl enable zed_x_daemon.service
sudo systemctl enable driver_zed_loader.service
sudo systemctl enable IMU_Daemon.service

rm /tmp/stereolabs_preinst_passed &> /dev/null

sync

exit 0
