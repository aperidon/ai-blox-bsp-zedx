+#include <dt-bindings/gpio/tegra234-gpio.h>
+#include "dt-bindings/input/input.h"
+#include "tegra234-p3509-a02-pwm-fan.dtsi"
+#include "tegra234-p3509-a02-pcie.dtsi"
+#include "tegra234-p3509-a02-fixed-regulator.dtsi"
+#include "tegra234-p3509-audio.dtsi"
+//#include "tegra234-p3768-camera-rbpcv3-imx477.dtsi"
+//#include "tegra234-p3768-camera-rbpcv2-imx219.dtsi"
+
+// For ZEDBox carrier board CSI pinout (22p/4l) --> use zed_box_orin include
+// For NVIDIA carrier board CSI pinout (15p/2l) --> use zed_box_orin include
+
+//sl_placeholder
+
+#define USB2_HUB_RESET	TEGRA234_MAIN_GPIO(G, 6)
+#define PWR_LED		TEGRA234_MAIN_GPIO(Z, 6)
+
+/ {
+	gpio-keys {
+		compatible = "gpio-keys";
+		gpio-keys,name = "gpio-keys";
+		status = "okay";
+
+		forcerecovery {
+			label = "force-recovery";
+			gpios = <&tegra_main_gpio TEGRA234_MAIN_GPIO(G, 0) GPIO_ACTIVE_LOW>;
+			linux,code = <BTN_1>;
+		};
+
+		power_key {
+			label = "power-key";
+			gpios = <&tegra_aon_gpio TEGRA234_AON_GPIO(EE, 4) GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_POWER>;
+			gpio-key,wakeup;
+		};
+	};
+
+	eeprom-manager {
+		data-size = <0x100>;
+		bus@0 {
+			i2c-bus = <&gen1_i2c>;
+			eeprom@1 {
+				slave-address = <0x57>;
+				label = "cvb";
+			};
+		};
+
+		bus@1 {
+			i2c-bus = <&gen2_i2c>;
+			eeprom@1 {
+				slave-address = <0x50>;
+				label = "super-module";
+			};
+		};
+	};
+
+	gpio@2200000 {
+		usb2-hub-reset-high {
+			status = "okay";
+			gpio-hog;
+			output-high;
+			gpios = <USB2_HUB_RESET 0>;
+			label = "usb2-hub-reset";
+		};
+
+		pwr-led-high {
+			status = "okay";
+			gpio-hog;
+			output-high;
+			gpios = <PWR_LED 0>;
+			label = "pwr-led";
+		};
+	};
+
+	pcie@141e0000 {					//added to enable PCIe x1 for Wifi connector J24 on JNX45/46(fd)
+		/*
+		 * C7 - M2 Key M, default config, other config possible as
+		 * below:
+		 * C7 x2 - default
+		 * C7 x1 or C9 x1
+		 */
+		status = "okay";
+		phys = <&p2u_gbe_0>, <&p2u_gbe_1>;
+		phy-names = "p2u-0";
+	};
+
+
+	xusb_padctl: xusb_padctl@3520000 {
+		status = "okay";
+		pads {
+			usb2 {
+				lanes {
+					usb2-0 {
+						nvidia,function = "xusb";
+						status = "okay";
+					};
+					usb2-1 {
+						nvidia,function = "xusb";
+						status = "okay";
+					};
+					usb2-2 {
+						nvidia,function = "xusb";
+						status = "okay";
+					};
+					usb2-3 {						//added for USB3 on the JNX42(fd)
+						nvidia,function = "xusb";
+						status = "okay";
+					};
+				};
+			};
+			usb3 {
+				lanes {
+					usb3-0 {
+						nvidia,function = "xusb";
+						status = "okay";
+					};
+					usb3-1 {						//added for USB3 on the JNX42(fd)
+						nvidia,function = "xusb";
+						status = "okay";
+					};
+					usb3-2 {						//added for USB3 on the JNX42(fd)
+						nvidia,function = "xusb";
+						status = "okay";
+					};
+
+				};
+			};
+		};
+
+		ports {
+			usb2-0 {
+				mode = "otg";
+				status = "okay";
+                                vbus-supply = <&p3509_vdd_5v_sys>;
+#if TEGRA_XUSB_DT_VERSION >= DT_VERSION_3
+				usb-role-switch;
+				connector {
+					compatible = "usb-b-connector", "gpio-usb-b-connector";
+					label = "micro-USB";
+					type = "micro";
+					vbus-gpio = <&tegra_main_gpio TEGRA234_MAIN_GPIO(Z, 1) GPIO_ACTIVE_LOW>;
+				};
+#endif
+			};
+			usb2-1 {
+				mode = "host";
+                                vbus-supply = <&p3509_vdd_av10_hub>;
+				status = "okay";
+			};
+			usb2-2 {/* Goes to M2.E */
+				mode = "host";
+                                vbus-supply = <&p3509_vdd_5v_sys>;
+				status = "okay";
+			};
+			usb2-3 {						//added for USB3 on the JNX42(fd)
+				mode = "host";
+				status = "okay";
+			};
+			usb3-0 {
+				nvidia,usb2-companion = <1>;
+				status = "okay";
+			};
+			usb3-1 {						//added for USB3 on the JNX42(fd)
+				nvidia,usb2-companion = <2>;
+				status = "okay";
+			};
+			usb3-2 {						//added for USB3 on the JNX42(fd)
+				nvidia,usb2-companion = <3>;
+				status = "okay";
+			};
+		};
+	};
+
+	tegra_xudc: xudc@3550000 {
+		status = "okay";
+		phys = <&{/xusb_padctl@3520000/pads/usb2/lanes/usb2-0}>;
+		phy-names = "usb2-0";
+		nvidia,xusb-padctl = <&xusb_padctl>;
+	};
+
+	tegra_xhci: xhci@3610000 {
+		status = "okay";
+		phys = <&{/xusb_padctl@3520000/pads/usb2/lanes/usb2-1}>,
+				<&{/xusb_padctl@3520000/pads/usb2/lanes/usb2-2}>,
+				<&{/xusb_padctl@3520000/pads/usb2/lanes/usb2-3}>,			//added for USB3 on the JNX42(fd)
+				<&{/xusb_padctl@3520000/pads/usb3/lanes/usb3-0}>,
+				<&{/xusb_padctl@3520000/pads/usb3/lanes/usb3-1}>,			//added for USB3 on the JNX42(fd)
+				<&{/xusb_padctl@3520000/pads/usb3/lanes/usb3-2}>;			//added for USB3 on the JNX42(fd)
+		phy-names = "usb2-1", "usb2-2", "usb2-3", "usb3-0", "usb3-1", "usb3-2"; 	//added usb2-3, usb3-1 and usb3-2 for USB3 on the JNX42(fd)
+		nvidia,xusb-padctl = <&xusb_padctl>;
+	};
+
+	spi@3210000{ /* SPI1 in 40 pin conn */
+		status = "okay";
+		spi@0 { /* chip select 0 */
+			compatible = "tegra-spidev";
+			reg = <0x0>;
+			spi-max-frequency = <50000000>;
+			controller-data {
+				nvidia,enable-hw-based-cs;
+				nvidia,rx-clk-tap-delay = <0x10>;
+				nvidia,tx-clk-tap-delay = <0x0>;
+			};
+		};
+		spi@1 { /* chip select 1 */
+			compatible = "tegra-spidev";
+			reg = <0x1>;
+			spi-max-frequency = <50000000>;
+			controller-data {
+				nvidia,enable-hw-based-cs;
+				nvidia,rx-clk-tap-delay = <0x10>;
+				nvidia,tx-clk-tap-delay = <0x0>;
+			};
+		};
+	};
+
+	spi@3230000{ /* SPI3 in 40 pin conn */
+		status = "okay";
+		spi@0 { /* chip select 0 */
+			compatible = "tegra-spidev";
+			reg = <0x0>;
+			spi-max-frequency = <50000000>;
+			controller-data {
+				nvidia,enable-hw-based-cs;
+				nvidia,rx-clk-tap-delay = <0x10>;
+				nvidia,tx-clk-tap-delay = <0x0>;
+			};
+		};
+		spi@1 { /* chips select 1 */
+			compatible = "tegra-spidev";
+			reg = <0x1>;
+			spi-max-frequency = <50000000>;
+			controller-data {
+				nvidia,enable-hw-based-cs;
+				nvidia,rx-clk-tap-delay = <0x10>;
+				nvidia,tx-clk-tap-delay = <0x0>;
+			};
+		};
+	};
+
+
+	/*combined-uart {		//disable combined uart to allow RS485 messages to be send(fd)
+		status = "disabled";
+	};
+
+	serial@c280000 {		//added for RS485 to work on JNX45/JNX46(fd)
+		status = "okay";
+	};*/
+	serial@3110000 {		//added for RS485/UART0 to work on JNX45/JNX46(fd)
+		status = "okay";
+	};
+
+
+	serial@3100000 {/* UARTA, for 40 pin header */
+		status = "okay";
+	};
+
+	mttcan@c310000 {
+		status = "okay";
+	};
+
+	serial@3140000 {
+		/* UARTE, Goes to M2.E and also some of the pins to bootstrap */
+		status = "okay";
+	};
+
+	serial@31d0000 {/* UARTI - SBSA */
+		status = "okay";
+	};
+
+	tachometer@39c0000 {
+		status = "okay";
+		upper-threshold = <0xfffff>;
+		lower-threshold = <0x0>;
+	};
+
+	pwm@3280000 {/* PWM1 40pin header, pin 15 */
+		status = "okay";
+	};
+
+	pwm@32a0000 {/* PWM3 - FAN */
+		status = "okay";
+	};
+
+	pwm@c340000 { /* PWM4 - OVR */
+		status = "disabled";
+	};
+
+	pwm@32c0000 {/* PWM5 40 pin header, pin 33 */
+		status = "okay";
+	};
+
+	pwm@32d0000 {/* PWM6 OVR */
+		status = "disabled";
+	};
+
+	pwm@32e0000 {/* PWM7 - 40pin header, pin 32 */
+		status = "okay";
+	};
+
+	bluedroid_pm {
+		status = "disabled";
+	};
+
+	display@13800000 {
+		status = "okay";
+		os_gpio_hotplug_a = <&tegra_main_gpio TEGRA234_MAIN_GPIO(M, 0) GPIO_ACTIVE_HIGH>;
+	};
+};
